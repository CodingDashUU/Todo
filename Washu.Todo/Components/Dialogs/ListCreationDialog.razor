@using Washu.Framework.SharedComponents
@using Washu.Todo.TodoList
@inherits FormDialog<ListCreationDialog.Model>
<ApplicationForm
    @ref="Form"
    Model="_model"
    HandleValidSubmit="_ => CloseDialog(new CreateListCommand(_model.ListName))">
    <RadzenFormField Text="List Name">
        <RadzenTextBox Name="@nameof(Model.ListName)" 
                       @bind-Value="_model.ListName"
                       MaxLength="ListName.MaximumLength" />
    </RadzenFormField>
</ApplicationForm>
@code {
    private readonly Model _model = new();
    public class Model
    {
        public string ListName { get; set; } = string.Empty;
    }
}
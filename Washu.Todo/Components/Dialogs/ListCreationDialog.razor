@using FluentValidation
@using Washu.Todo.Commands
@inject DialogService DialogService
<AppForm
    Model="_model"
    Validator="_validator"
    HandleValidSubmit="CloseDialog">
    <RadzenFormField Text="List Name">
        <RadzenTextBox Name="@nameof(Model.ListName)" 
                       @bind-Value="_model.ListName"
                       MaxLength="TodoRules.ListName.MaximumLength" />
    </RadzenFormField>
</AppForm>
@code {
    private readonly Model _model = new();
    private readonly Validator _validator = new();
    
    [Parameter] public Guid UserId { get; set; }
    private void CloseDialog()
    {
        var command = new CreateListCommand(UserId, _model.ListName);
        DialogService.Close(command);
    }

    private class Model
    {
        public string ListName { get; set; } = string.Empty;
    }
    private class Validator : AbstractValidator<Model>
    {
        public Validator() =>
            RuleFor(m => m.ListName)
                .SetValidator(new TodoValidators.ListName());
    }
}
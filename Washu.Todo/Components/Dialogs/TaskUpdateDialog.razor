@using FluentValidation
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Features
@inject UserTimeZoneProvider TimeZoneProvider
@inject DialogService DialogService
<ApplicationForm
    Model="_model"
    Validator="_validator"
    SubmitButtonConfig="_submitButtonConfig"
    HandleValidSubmit="CloseDialog"
    >
    <RadzenFormField Text="New Task Name">
        <RadzenTextBox @bind-Value="_model.NewTaskName"/>
    </RadzenFormField>
    <RadzenFormField Text="New Goal Date">
        <LocalDateTimePicker
            @bind-Value="_model.NewGoalDate"
            MinUtc="DateTimeOffset.UtcNow.AddMinutes(5).WithoutSeconds"
            MaxUtc="DateTimeOffset.UtcNow.AddYears(50).WithoutSeconds"
        />
    </RadzenFormField>
</ApplicationForm>
@code {
    private readonly Model _model = new();
    private Validator _validator = null!;
    private readonly SubmitButtonConfig _submitButtonConfig = new()
    {
        ButtonText = "Update Task"
    };
    [Parameter, EditorRequired] public TaskEntry OldEntry { get; set; }
    [Parameter, EditorRequired] public Guid ListId { get; set; }
    [Parameter, EditorRequired] public uint ListVersionId { get; set; }
   
    protected override void OnInitialized()
    {
        _model.NewGoalDate = OldEntry.GoalDate.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
        _model.NewTaskName = OldEntry.Name;
        _validator = new Validator(OldEntry);
    }
    private void CloseDialog()
    {
        var command = new UpdateTaskCommand(OldEntry.Id, _model.NewTaskName, _model.NewGoalDate, ListId, ListVersionId);
        DialogService.Close(command);
    }

    private class Model
    {
        public string NewTaskName { get; set; } = string.Empty;
        public DateTimeOffset NewGoalDate { get; set; }
    }
    private class Validator : AbstractValidator<Model>
    {
        public Validator(TaskEntry oldEntry)
        {
            RuleFor(m => m.NewTaskName)
                .SetValidator(new TaskNameValidator())
                .Unless(m => oldEntry.Name == m.NewTaskName);
            RuleFor(m => m.NewGoalDate)
                .SetValidator(new GoalDateValidator())
                .Unless(m => oldEntry.GoalDate == m.NewGoalDate);
        }

    }
}
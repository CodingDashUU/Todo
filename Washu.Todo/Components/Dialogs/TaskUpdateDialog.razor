@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Commands
@inject UserTimeZoneProvider TimeZoneProvider
@inject DialogService DialogService
<AppForm
    Model="Model"
    Validator="Validator"
    SubmitButtonConfig="SubmitButtonConfig"
    HandleValidSubmit="CloseDialog"
    >
    <RadzenFormField Text="New Task Name">
        <RadzenTextBox @bind-Value="Model.NewTaskName"/>
    </RadzenFormField>
    <RadzenFormField Text="New Goal Date">
        <RadzenDatePicker
            TValue="DateTimeOffset"
            @bind-Value="Model.NewGoalDate"
            ShowTime
            Min="DateTimeOffset.UtcNow.AddMinutes(5).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"
            Max="DateTimeOffset.UtcNow.AddYears(50).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"/>
    </RadzenFormField>
</AppForm>
@code {
    public UpdateTask.Model Model { get; } = new();
    [Parameter] public required TaskEntry OldEntry { get; set; }
    public UpdateTask.Validator Validator { get; set; }= null!;

    public SubmitButtonConfig SubmitButtonConfig { get; set; } = new()
    {
        ButtonText = "Update Task"
    };
    protected override void OnInitialized()
    {
        Model.NewGoalDate = OldEntry.GoalDate.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
        Model.NewTaskName = OldEntry.Name;
        Validator = new UpdateTask.Validator(OldEntry);
    }
    private Task CloseDialog()
    {
        DialogService.Close(Model);
        return Task.CompletedTask;
    }
}
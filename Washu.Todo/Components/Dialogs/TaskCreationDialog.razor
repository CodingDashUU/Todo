@using FluentValidation
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Features
@inject DialogService DialogService
@inject UserTimeZoneProvider TimeZoneProvider
<ApplicationForm
    Model="_model"
    Validator="_validator"
    HandleValidSubmit="CloseDialog"
    >
    <RadzenFormField Text="Task Name">
        <RadzenTextBox @bind-Value="_model.TaskName"/>
    </RadzenFormField>
    <RadzenFormField Text="Goal Date">
        <LocalDateTimePicker
            @bind-Value="_model.GoalDate"
            MinUtc="DateTimeOffset.UtcNow.AddMinutes(5).WithoutSeconds"
            MaxUtc="DateTimeOffset.UtcNow.AddYears(50).WithoutSeconds"
        />
    </RadzenFormField>
</ApplicationForm>


@code {
    private readonly Model _model = new();
    private readonly Validator _validator = new();
    [Parameter, EditorRequired] public Guid ListId { get; set; }
    [Parameter, EditorRequired] public uint ListVersionId { get; set; }
    protected override void OnInitialized()
    {
        _model.GoalDate = DateTimeOffset.UtcNow.AddHours(1).ToTimeZone(TimeZoneProvider.TimeZoneInfo).WithoutSeconds;
    }
    private void CloseDialog()
    {
        var command = new CreateTaskCommand(ListId, ListVersionId, _model.TaskName, _model.GoalDate);
        DialogService.Close(command);
    }
    private class Model
    {
        public string TaskName { get; set; } = string.Empty;
        public DateTimeOffset GoalDate { get; set; }
    }
    private class Validator : AbstractValidator<Model>
    {
        public Validator()
        {
            RuleFor(x => x.TaskName)
                .SetValidator(new TaskNameValidator());
            RuleFor(x => x.GoalDate)
                .SetValidator(new GoalDateValidator());
        }
    }
}
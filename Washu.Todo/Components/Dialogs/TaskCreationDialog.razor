@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Commands
@inject DialogService DialogService
@inject UserTimeZoneProvider TimeZoneProvider
<AppForm
    Model="Model"
    Validator="Validator"
    HandleValidSubmit="CloseDialog"
    >
    <RadzenFormField Text="Task Name">
        <RadzenTextBox @bind-Value="Model.TaskName"/>
    </RadzenFormField>
    <RadzenFormField Text="Goal Date">
        <RadzenDatePicker
            TValue="DateTimeOffset"
            @bind-Value="Model.GoalDate"
            ShowTime
            Min="DateTimeOffset.UtcNow.AddMinutes(5).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"
            Max="DateTimeOffset.UtcNow.AddYears(50).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"/>
    </RadzenFormField>
</AppForm>


@code {
    private CreateTask.Model Model { get; } = new();
    [Parameter] public required Todo.TodoList List { get; set; }
    private CreateTask.Validator Validator { get; set; } = null!;

    protected override void OnInitialized()
    {
        Model.GoalDate = DateTimeOffset.UtcNow.AddHours(1).ToTimeZone(TimeZoneProvider.TimeZoneInfo);
        Validator = new CreateTask.Validator(List);
    }
    private Task CloseDialog()
    {
        DialogService.Close(Model);
        return Task.CompletedTask;
    }
}
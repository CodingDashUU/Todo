@using FluentValidation
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Commands
@inject DialogService DialogService
@inject UserTimeZoneProvider TimeZoneProvider
<AppForm
    Model="_model"
    Validator="_validator"
    HandleValidSubmit="CloseDialog"
    >
    <RadzenFormField Text="Task Name">
        <RadzenTextBox @bind-Value="_model.TaskName"/>
    </RadzenFormField>
    <RadzenFormField Text="Goal Date">
        <RadzenDatePicker
            TValue="DateTimeOffset"
            @bind-Value="_model.GoalDate"
            ShowTime
            Min="DateTimeOffset.UtcNow.AddMinutes(5).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"
            Max="DateTimeOffset.UtcNow.AddYears(50).ToTimeZone(TimeZoneProvider.TimeZoneInfo).DateTime"/>
    </RadzenFormField>
</AppForm>


@code {
    private readonly Model _model = new();
    private readonly Validator _validator = new();
    [Parameter] public required Guid ListId { get; set; }
    [Parameter] public required Guid ListVersionId { get; set; }
    protected override void OnInitialized()
    {
        _model.GoalDate = DateTimeOffset.UtcNow.AddHours(1).ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    private void CloseDialog()
    {
        var command = new CreateTaskCommand(ListId, ListVersionId, _model.TaskName, _model.GoalDate);
        DialogService.Close(command);
    }
    private class Model
    {
        public string TaskName { get; set; } = string.Empty;
        public DateTimeOffset GoalDate { get; set; }
    }
    private class Validator : AbstractValidator<Model>
    {
        public Validator()
        {
            RuleFor(x => x.TaskName)
                .SetValidator(new TodoValidators.TaskName());
            RuleFor(x => x.GoalDate)
                .SetValidator(new TodoValidators.GoalDate());
        }
    }
}
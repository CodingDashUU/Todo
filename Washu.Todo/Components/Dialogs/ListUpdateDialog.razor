@using FluentValidation
@using Washu.Todo.Lists
@using TodoList = Washu.Todo.Lists.Features.TodoList
@inject DialogService DialogService
<ApplicationForm
    Model="_model"
    Validator="_validator"
    SubmitButtonConfig="ButtonConfig"
    HandleValidSubmit="CloseDialog">
    <RadzenFormField Text="New List Name">
        <RadzenTextBox Name="@nameof(Model.NewListName)" 
                       @bind-Value="_model.NewListName"
                       MaxLength="ListName.MaximumLength" />
    </RadzenFormField>
</ApplicationForm>
@code {
    private readonly Model _model = new();
    private Validator _validator = null!;
    private static readonly SubmitButtonConfig ButtonConfig = new()
    {
        ButtonText = "Update List",
        ButtonIcon = MaterialIcons.Update
    };
    [Parameter, EditorRequired] public TodoList OldList { get; set; }

    protected override void OnInitialized()
    {
        _model.NewListName = OldList.Name;
        _validator = new Validator(OldList);
    }

    private void CloseDialog()
    {
        var command = new UpdateListCommand(OldList.Id, OldList.RowVersion, _model.NewListName);
        DialogService.Close(command);
    }

    private class Model
    {
        public string NewListName { get; set; } = string.Empty;
    }
    private class Validator : AbstractValidator<Model>
    {
        public Validator(TodoList oldList) =>
            RuleFor(m => m.NewListName)
                .SetValidator(new ListNameValidator())
                .Must(m => IsDifferent(oldList.Name, m)).WithMessage("New name must be different from the old name");
        
        private static bool IsDifferent(string oldName, string newName) => oldName != newName;
    }
}
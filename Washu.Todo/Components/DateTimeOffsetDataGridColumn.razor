@typeparam TItem where TItem : class
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@inject UserTimeZoneProvider TimeZoneProvider
@inherits RadzenDataGridColumn<TItem>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        FilterOperator = FilterOperator.LessThan;
        FilterValueTemplate = context => @<RadzenDatePicker TValue="DateTimeOffset?"
                                                 ShowTime
                                                 DateFormat="@DataGridConstants.DateTimeFormat"
                                                 Value="((DateTimeOffset?)context.FilterValue)?.ToTimeZone(TimeZoneProvider.TimeZoneInfo)"
                                                 ValueChanged="async v => { context.FilterValue = v; await Grid.Reload(); }"
                                                 AllowClear/>;
    }
    public override IEnumerable<FilterOperator> GetFilterOperators()
    {
        var operators = base.GetFilterOperators();

        if (FilterPropertyType == typeof(DateTimeOffset) ||  FilterPropertyType == typeof(DateTimeOffset?))
        {
            operators = operators.Where(o => 
                o is    not FilterOperator.LessThanOrEquals
                    and not FilterOperator.GreaterThanOrEquals
                    and not FilterOperator.Equals
                    and not FilterOperator.NotEquals);
        }
        return operators;
    }
}
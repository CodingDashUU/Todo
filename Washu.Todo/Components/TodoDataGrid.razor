@using System.Diagnostics
@using Microsoft.EntityFrameworkCore
@using System.Linq.Dynamic.Core 
@using Humanizer
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Framework.Identity.Users
@using Washu.Framework.Identity.Users.FindUser
@using Washu.Framework.Notifications
@using Washu.Framework.Radzen.Buttons
@using Washu.Framework.Radzen.DataGrid
@using Washu.Framework.Radzen.Notifications
@using Washu.Todo.Components.Dialogs
@using Washu.Todo.Extensions
@using Washu.Todo.Lists
@using Washu.Todo.Lists.Features
@using Washu.Todo.Persistence
@using Washu.Todo.Tasks
@using Washu.Todo.Tasks.Features
@inject UserTimeZoneProvider TimeZoneProvider
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject GetUserService GetUserService
@inject CreateListHandler CreateListHandler
@inject CreateTaskHandler CreateTaskHandler
@inject ToggleTaskHandler ToggleTaskHandler
@inject UpdateTaskHandler UpdateTaskHandler
@inject UpdateListHandler UpdateListHandler
@inject DeleteTaskHandler DeleteTaskHandler
@inject DeleteListHandler DeleteListHandler
@inject NotificationService NotificationService
@inject DialogService DialogService
<RadzenDataGrid @ref="_grid" 
                @bind-Value="@_selectedTasks" 
                TItem="TaskEntry"
                AllowFiltering
                AllowColumnResize
                AllowAlternatingRows 
                AllowSorting
                AllowPaging
                ShowPagingSummary
                PageSize="10"  
                Style="max-height: 77vh"
                FilterMode="FilterMode.SimpleWithMenu" 
                PagerHorizontalAlign="HorizontalAlign.Left"
                SelectionMode="DataGridSelectionMode.Single" 
                IsLoading="@_isLoading"  
                Data="@_tasks" 
                Count="@_count"
                LoadData="@LoadData" 
                Filter="FilterHelpers.OnFilter" 
                FilterCleared="FilterHelpers.OnFilterCleared"
                ColumnWidth="300px"
                IsNullText="Is N/A" 
                IsNotNullText="Is not N/A">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenFormField Text="Selected Todo List">
                    <RadzenDropDownDataGrid
                        @ref="_dropDownGrid"
                        Style="width: 600px"
                        TValue="TodoList"
                        Value="@_selectedList"
                        Count="_listsCount"
                        IsLoading="_isListsDataLoading"
                        Data="@_lists"
                        ValueChanged="OnListSelected"
                        LoadData="LoadListsAsync"
                        AllowColumnResize
                        AllowSorting
                        ShowPagingSummary
                        TextProperty="@nameof(TodoList.Name)">
                        <FooterTemplate>
                            <RadzenStack>
                                <AddButton Text="Add List" Outlined Click="CreateListAsync"/>
                            </RadzenStack>
                        </FooterTemplate>
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(TodoList.Name)" Title="List Name" Width="100px"/>
                            <RadzenDropDownDataGridColumn Property="@nameof(TodoList.CreationDate)" Title="Created At" Width="100px">
                                <Template>
                                    @ToTimeZoneAndString(((TodoList)context).CreationDate)
                                </Template>
                            </RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Filterable="false" Sortable="false" Width="100px" TextAlign="TextAlign.Center" Frozen="true" Resizable="false">
                                <Template>
                                    <AddButton Click="_ => CreateTaskAsync(context)"/>
                                    <EditButton Click="_ => UpdateListAsync(context)"/>
                                    <DeleteButton Click="_ => DeleteListAsync(context)"/>
                                </Template>
                            </RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                </RadzenFormField>
                <ToggleButton 
                    IsOn="_isEditing"
                    Toggle="@ToggleEditing"
                    ButtonOnText="Edit Mode: ON"
                    ButtonOffText="Edit Mode: OFF"
                    IsDisabled="IsNoListSelected"/>
            <DataGridExportButton DataGrid="_grid" ExcelTitle="@_selectedList.Name" FileName="todo" DisableExportAllScope="@(_count > 999)"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.Name)" Title="Task Name" Width="140px">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <IconColourToggle Icon="@MaterialIcons.Task" IsOn="context.IsCompleted"/>
                    }
                    @context.Name
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.DateCreated)" Title="Date Created" Width="160px">
            <Template>
                @ToTimeZoneAndString(context.DateCreated)
            </Template>
        </DateTimeOffsetDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.GoalDate)" Title="Goal Date" Width="160px" FilterMode="FilterMode.SimpleWithMenu">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <RadzenIcon Icon="@MaterialIcons.Target"/>
                    }
                    @ToTimeZoneAndString(context.GoalDate)
                </RadzenStack>
            </Template>
        </DateTimeOffsetDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.DateCompleted)" Title="Date Completed" Width="160px" FilterMode="FilterMode.SimpleWithMenu">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    @{
                        var now = DateTimeOffset.UtcNow;
                        var state = DetermineCompletionState(context, now);
                        if (!_isEditing)
                        {
                            switch (state)
                            {
                                case TaskCompletionState.Completed:
                                    <RadzenIcon IconColor="var(--rz-success)" Icon="@MaterialIcons.CheckCircle"/>
                                    break;
                                case TaskCompletionState.NotCompletedInTime or TaskCompletionState.Overdue:
                                    <RadzenIcon IconColor="var(--rz-danger)" Icon="@MaterialIcons.Cancel"/>
                                    break;
                                default:
                                    <RadzenIcon IconColor="var(--rz-warning)" Icon="@MaterialIcons.QuestionBox"/>
                                    break;
                            }   
                        }
                        <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                            @(context.DateCompleted.HasValue ? ToTimeZoneAndString(context.DateCompleted.Value) : "N/A")
                            @if (!_isEditing)
                            {
                                switch (state)
                                {
                                    case TaskCompletionState.NotCompletedInTime:
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Failed to complete in time (@((context.DateCompleted! - context.GoalDate).Value.Humanize()) late)</RadzenText>
                                        break;
                                    case TaskCompletionState.Overdue:
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Overdue (@((now - context.GoalDate).Humanize()) late)</RadzenText>
                                        break;
                                }
                            }
                        </RadzenStack>
                        <div/>
                    }
                </RadzenStack>
            </Template>
        </DateTimeOffsetDataGridColumn>
        @if (!_isEditing)
        {
            <RadzenDataGridColumn Property="@nameof(TaskEntry.IsCompleted)" Title="Completed?" TextAlign="TextAlign.Center" Width="75px">
                <Template>
                    <IconToggle IsOn="context.IsCompleted"/>
                </Template>
            </RadzenDataGridColumn>
        }
        @if (_isEditing)
        {
            <RadzenDataGridColumn Filterable="false" Sortable="false" Width="100px" TextAlign="TextAlign.Center" Frozen="true" Resizable="false">
                <Template>
                    <IconToggleButton IsOn="context.IsCompleted" Toggle="_ => OnToggleTaskAsync(context)" />
                    <EditButton Click="_ => OnEditTaskAsync(context)" />
                    <DeleteButton Click="_ => OnDeleteTaskAsync(context)"/>
                </Template>
            </RadzenDataGridColumn>
        }
    </Columns>
    <FooterTemplate>
        @if (_count > 0)
        {
            var percentage = _completedTasks / (double)_count;
            <RadzenText Style="@("color:" + DetermineCssVarColour(percentage))" TextAlign="TextAlign.Center">
                Completed Tasks: @_completedTasks / @_count (@ToRoundedPresentablePercentage(percentage)%)
            </RadzenText>
        }
    </FooterTemplate>
</RadzenDataGrid>

@code {
    RadzenDataGrid<TaskEntry> _grid = null!;
    RadzenDropDownDataGrid<TodoList> _dropDownGrid = null!;
    bool _isLoading;
    int _count;
    int _completedTasks;
    private bool _isEditing;
    IEnumerable<TaskEntry>? _tasks;
    IList<TaskEntry> _selectedTasks = [];
    TodoList _selectedList = TodoList.None;
    List<TodoList> _lists = [];
    private int _listsCount;
    private bool _isListsDataLoading;
    private Task? _initTask;
    private Guid _userId;
    private bool IsNoListSelected => _selectedList.Id == TodoList.None.Id;
    private DataGridFilterHelpers<TaskEntry> FilterHelpers => new(_grid);
    private void ToggleEditing() => _isEditing = !_isEditing;
    private string ToTimeZoneAndString(DateTimeOffset date) => date.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString(DataGridConstants.DateTimeFormat);
    private async Task OnToggleTaskAsync(TaskEntry entry)
    {
        var command = new ToggleTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await ToggleTaskHandler.HandleAsync(command);
        if (message.Type is not MessageType.Success)
            NotificationService.Show(message, duration: RadzenNotificationConstants.ShortDuration);
        
        await RefreshStateAsync(_selectedList.Id);
    }
    private enum TaskCompletionState : byte { NotCompleted, Overdue, NotCompletedInTime, Completed }
    private static TaskCompletionState DetermineCompletionState(TaskEntry entry, DateTimeOffset now)
    {
        var completed = entry is { IsCompleted: true, DateCompleted: not null };
        var notCompleteInTime = completed && entry.DateCompleted > entry.GoalDate;
        var overdue = !completed && now > entry.GoalDate;
    
        if (overdue) return TaskCompletionState.Overdue;
        if (!completed) return TaskCompletionState.NotCompleted;
        return notCompleteInTime 
            ? TaskCompletionState.NotCompletedInTime 
            : TaskCompletionState.Completed;
    }

    private static string DetermineCssVarColour(double percentage) => percentage switch
    {
        > 0.0 and < 1.0 => "var(--rz-warning)",
        >= 1.0 => "var(--rz-success)",
        _ => "var(--rz-danger)"
    };

    private static double ToRoundedPresentablePercentage(double percentage) => Math.Round(percentage * 100.0, 2);
    private async Task OnDeleteTaskAsync(TaskEntry entry)
    {
        var confirmData = await DialogService.ConfirmDelete(
            "Confirm Task Deletion",
            $"Are you sure you want to delete {entry.Name}? You cannot undo this action!");
            
        if (confirmData != true) return;

        var command = new DeleteTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await DeleteTaskHandler.HandleAsync(command);
        NotificationService.Show(message);
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task OnEditTaskAsync(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?>(3)
        {
            [nameof(TaskUpdateDialog.OldEntry)] = entry,
            [nameof(TaskUpdateDialog.ListId)] = _selectedList.Id,
            [nameof(TaskUpdateDialog.ListVersionId)] = _selectedList.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (result is not UpdateTaskCommand command) return;

        var message = await UpdateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(_selectedList.Id);
    }

    private static readonly LoadDataArgs DefaultListsLoadDataArgs = new()
    {
        Skip = 0,
        Top = 5
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var info = await GetUserService.GetOrRedirectAsync(ApplicationRoutes.ManageAccount);
        _userId = info.Id;
        _initTask = LoadListsAsync(DefaultListsLoadDataArgs);
    }

    private async Task DeleteListAsync(TodoList list)
    {
        var confirmData = 
        await DialogService.ConfirmDelete("Confirm List Deletion", $"Are you sure you want to delete '{list.Name}'?");
            
        if (!confirmData) return;

        var command = new DeleteListCommand(list.Id);
        var message = await DeleteListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync();
    }

    private async Task CreateListAsync()
    {
        var result = await DialogService.OpenAsync<ListCreationDialog>("Create List");
        if (result is not CreateListCommand command) return;

        var message = await CreateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(); 
    }

    private async Task CreateTaskAsync(TodoList list)
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(TaskCreationDialog.ListId)] = list.Id, 
            [nameof(TaskCreationDialog.ListVersionId)] = list.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (result is not CreateTaskCommand command) return;

        var message = await CreateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(list.Id);
    }
    
    private async Task RefreshStateAsync(Guid? preferredListId = null)
    {
        await LoadListsAsync(DefaultListsLoadDataArgs);
        
        var listIdToSelect = preferredListId ?? _selectedList.Id;
        _selectedList = _lists.FirstOrDefault(l => l.Id == listIdToSelect) ?? _lists.FirstOrDefault() ?? TodoList.None;
        
        await _grid.Reload();
    }

    private async Task UpdateListAsync(TodoList list)
    {
        var parameters = new Dictionary<string, object?>(1)
        {
            [nameof(ListUpdateDialog.OldList)] = list
        };
        var result = await DialogService.OpenAsync<ListUpdateDialog>("Update List", parameters);
        if (result is not UpdateListCommand command) return;

        var message = await UpdateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(list.Id);
    }

    void OnListSelected(TodoList newList)
    {
        _selectedList = newList;
        _grid.FirstPage(forceReload: true);
    }

    private async Task LoadListsAsync(LoadDataArgs args)
    {
        try
        {
            _isListsDataLoading = true;
            await InvokeAsync(StateHasChanged);
            
            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = await context.TodoLists
                .AsNoTracking()
                .ForUser(_userId)
                .OrderByDescending(e => e.LastModifiedDate.HasValue)
                .ThenByDescending(e => e.LastModifiedDate)
                .ThenByDescending(e => e.CreationDate)
                .AsQueryable()
                .ApplyDataGridDropDownFiltersAsync(args, async queryable =>
                {
                    _listsCount = await queryable.CountAsync();
                });
            _lists = _listsCount == 0 ? [] : await query.ToListAsync();
        }
        catch (Exception)
        {
            _lists = [];
            _listsCount = 0;
        }
        finally
        {
            _isListsDataLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        try
        {
            _isLoading = true;
            await InvokeAsync(StateHasChanged);

            if (_initTask is not null)
            {
                await _initTask;
                _initTask = null;
                _selectedList = _lists.FirstOrDefault() ?? TodoList.None;
            }
            
            if (_selectedList.Id == TodoList.None.Id)
            {
                _tasks = [];
                _count = 0;
                _completedTasks = 0;
                return;
            }

            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = await context.Tasks
                .AsNoTracking()
                .ForTodoList(_selectedList.Id)
                .OrderByDescending(e => e.DateCreated)
                .AsQueryable()
                .ApplyDataGridFiltersAsync(args, async queryable =>
                {
                    _count = await queryable.CountAsync();
                    _completedTasks = _count > 0 ? await queryable.CountAsync(t => t.IsCompleted) : 0;
                });
            
            _tasks = _count == 0 ? [] : await query.ToListAsync();

            if (_tasks.IsNotEmpty && _selectedTasks.IsEmpty)
            {
                _selectedTasks.Add(_tasks.First());
            }
        }
        catch (Exception)
        {
            _tasks = [];
            _count = 0;
            _completedTasks = 0;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
}
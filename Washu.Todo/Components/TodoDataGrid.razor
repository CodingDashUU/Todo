@using Microsoft.EntityFrameworkCore
@using System.Linq.Dynamic.Core 
@using Microsoft.AspNetCore.WebUtilities
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Framework.Notifications
@using Washu.Todo.Identity
@using TodoList = Washu.Todo.TodoList
@inject UserTimeZoneProvider TimeZoneProvider
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject MessageStore Store
@inject AuthenticationStateProvider Provider
@inject NavigationManager NavManager


<RadzenDataGrid @ref="_grid" 
                @bind-Value="@_selectedTasks" 
                TItem="TaskEntry"
                AllowFiltering
                AllowColumnResize
                AllowAlternatingRows 
                AllowSorting
                AllowPaging
                ShowPagingSummary
                PageSize="10"  
                Style="height:600px"
                FilterMode="FilterMode.SimpleWithMenu" 
                PagerHorizontalAlign="HorizontalAlign.Left"
                SelectionMode="DataGridSelectionMode.Single" 
                IsLoading="@_isLoading"  
                Data="@_tasks" 
                Count="@_count"
                LoadData="@LoadData" 
                Filter="OnFilter" 
                FilterCleared="@OnFilterCleared"
                ColumnWidth="300px"
                IsNullText="Is N/A" 
                IsNotNullText="Is not N/A">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenFormField Text="Selected Todo List">
                <RadzenDropDownDataGrid 
                    TValue="Todo.TodoList"
                    Value="@_selectedList" 
                    Count="_listsCount"
                    IsLoading="_isListsDataLoading"
                    Data="@_lists"
                    ValueChanged="OnListSelected"
                    LoadData="LoadListsAsync"
                    TextProperty="@nameof(Todo.TodoList.Name)"
                />
            </RadzenFormField>
            <DataGridExportButton DataGrid="_grid" ExcelTitle="@_selectedList.Name" FileName="todo"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.Name)" Title="Task Name" Width="140px"/>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.DateCreated)" Title="Date Created" Width="160px" FilterValue="DateCreatedFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="DateCreatedFilterValue"/>
            </FilterValueTemplate>
            <Template>
                @context.DateCreated.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.GoalDate)" Title="Goal Date" Width="160px" FilterMode="FilterMode.SimpleWithMenu" FilterValue="GoalDateFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="GoalDateFilterValue"/>
            </FilterValueTemplate>
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.1rem">
                    <RadzenIcon Icon="@MaterialIcons.Target"/>
                    @context.GoalDate.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F")
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.DateCompleted)" Title="Date Completed" Width="160px" FilterMode="FilterMode.SimpleWithMenu" FilterValue="DateCompletedFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="DateCompletedFilterValue"/>
            </FilterValueTemplate>
            <Template>
                @(context.DateCompleted?.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F") ?? "N/A")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.IsCompleted)" Title="Completed?" TextAlign="TextAlign.Center" Width="100px">
            <Template>
                <RadzenIcon IconColor="@(context.IsCompleted ? "var(--rz-success)" : "var(--rz-danger)")" Icon="@(context.IsCompleted ? MaterialIcons.CheckCircle : MaterialIcons.Cancel)"/>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    
</RadzenDataGrid>

@code {
    RadzenDataGrid<TaskEntry> _grid = null!;
    bool _isLoading;
    int _count;
    IEnumerable<TaskEntry>? _tasks;
    IList<TaskEntry> _selectedTasks = [];
    Todo.TodoList _selectedList = Todo.TodoList.None;
    List<Todo.TodoList> _lists = [];
    private int _listsCount;
    private bool _isListsDataLoading;
    private Task? _initTask;
    DateTimeOffset? DateCreatedFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    DateTimeOffset? GoalDateFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    DateTimeOffset? DateCompletedFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    private static readonly LoadDataArgs DefaultListsLoadDataArgs = new()
    {
        Skip = 0,
        Top = 5
    };
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _initTask = LoadListsAsync(DefaultListsLoadDataArgs);
    }

    static bool IsNullOrEmpty(FilterOperator? value)
    {
        return value is FilterOperator.IsEmpty or FilterOperator.IsNotEmpty or FilterOperator.IsNull or FilterOperator.IsNotNull;
    }
    void OnListSelected(Todo.TodoList newList)
    {
        _selectedList = newList;
        StateHasChanged();
        _grid.Reload();
    }
    void OnFilter(DataGridColumnFilterEventArgs<TaskEntry> args)
    {
        if (IsNullOrEmpty(args.Column?.GetFilterOperator()))
        {
            OnFilterCleared(args);
        }
    }
    private void OnFilterCleared(DataGridColumnFilterEventArgs<TaskEntry> args)
    {
        switch (args.Column?.Property)
        {
            case nameof(TaskEntry.DateCreated):
                DateCreatedFilterValue = null;
                break;
            case nameof(TaskEntry.DateCompleted):    
                DateCompletedFilterValue = null;
                break;
            case nameof(TaskEntry.GoalDate):
                GoalDateFilterValue = null;
                break;
        }
        _grid.Reload();
    }
    private async Task LoadListsAsync(LoadDataArgs args)
    {
        var authState = await Provider.GetAuthenticationStateAsync();
        if (authState.User.UserId is not { } userId)
        {
            var id = Store.Store(Message.Error("Identity Error", "Please sign in before continuing"));
            NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?messageid={id}");
            return;
        }
        try
        {
            _isListsDataLoading = true;
            await InvokeAsync(StateHasChanged);
            
            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = context.TodoLists
                .AsNoTracking()
                .Where(t => t.UserId == userId)
                .OrderByDescending(e => e.LastModified)
                .AsQueryable();
            
            if (!string.IsNullOrEmpty(args.Filter))
            {
                query = query.Where(t => t.Name.ToLower().Contains(args.Filter.ToLower()));
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }
            _listsCount = await query.CountAsync();
            if (args.Skip is not null)
            {
                query = query.Skip(args.Skip.Value);
            }
            if (args.Top is not null)
            {
                query = query.Take(args.Top.Value);
            }

            if (_listsCount == 0)
            {
                _lists = [Todo.TodoList.None];
            }

            _lists = await query.ToListAsync();
        }
        catch (Exception)
        {
            _lists = [];
            _listsCount = 0;
        }
        finally
        {
            _isListsDataLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
    async Task LoadData(LoadDataArgs args)
    {
        try
        {
            _isLoading = true;
            await InvokeAsync(StateHasChanged);

            if (_initTask is not null)
            {
                await _initTask;
                _initTask = null;
                _selectedList = _lists.FirstOrDefault() ?? Todo.TodoList.None;
            }
            if (_selectedList.Id == Todo.TodoList.None.Id)
            {
                _tasks = [];
                _count = 0;
                return;
            }

            await using var context = await DbContextFactory.CreateDbContextAsync();
            
            var query = context.Tasks
                .AsNoTracking()
                .Where(e => e.TodoListId == _selectedList.Id)
                .OrderBy(e => e.DateCreated)
                .AsQueryable();

            if (!string.IsNullOrEmpty(args.Filter))
            {
                query = query.Where(args.Filter);
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }

            _count = await query.CountAsync();

            if (args.Skip is not null)
            {
                query = query.Skip(args.Skip.Value);
            }
            if (args.Top is not null)
            {
                query = query.Take(args.Top.Value);
            }
            _tasks = await query.ToListAsync();

            if (_tasks.IsNotEmpty && _selectedTasks.IsEmpty)
            {
                _selectedTasks.Add(_tasks.First());
            }
        }
        catch (Exception)
        {
            _tasks = [];
            _count = 0;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
}
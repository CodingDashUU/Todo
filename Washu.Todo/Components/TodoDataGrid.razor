@using Microsoft.EntityFrameworkCore
@using System.Linq.Dynamic.Core 
@using Humanizer
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Framework.Notifications
@using Washu.Todo.Components.Dialogs
@using Washu.Todo.Features
@using Washu.Todo.Identity
@inject UserTimeZoneProvider TimeZoneProvider
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject AuthenticationStateProvider Provider
@inject NavigationManager NavManager
@inject CreateListHandler CreateListHandler
@inject CreateTaskHandler CreateTaskHandler
@inject ToggleTaskHandler ToggleTaskHandler
@inject UpdateTaskHandler UpdateTaskHandler
@inject UpdateListHandler UpdateListHandler
@inject DeleteTaskHandler DeleteTaskHandler
@inject DeleteListHandler DeleteListHandler
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject ApplicationUserStore UserStore
<RadzenDataGrid @ref="_grid" 
                @bind-Value="@_selectedTasks" 
                TItem="TaskEntry"
                AllowFiltering
                AllowColumnResize
                AllowAlternatingRows 
                AllowSorting
                AllowPaging
                ShowPagingSummary
                PageSize="10"  
                Style="max-height: 77vh"
                FilterMode="FilterMode.SimpleWithMenu" 
                PagerHorizontalAlign="HorizontalAlign.Left"
                SelectionMode="DataGridSelectionMode.Single" 
                IsLoading="@_isLoading"  
                Data="@_tasks" 
                Count="@_count"
                LoadData="@LoadData" 
                Filter="OnFilter" 
                FilterCleared="@OnFilterCleared"
                ColumnWidth="300px"
                IsNullText="Is N/A" 
                IsNotNullText="Is not N/A">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenFormField Text="Selected Todo List">
                    <RadzenDropDownDataGrid
                        TValue="TodoList"
                        Value="@_selectedList"
                        Count="_listsCount"
                        IsLoading="_isListsDataLoading"
                        Data="@_lists"
                        ValueChanged="OnListSelected"
                        LoadData="LoadListsAsync"
                        TextProperty="@nameof(TodoList.Name)"/>
                </RadzenFormField>
                <RadzenButton class="big-icon-button"
                              ButtonStyle="@(_isEditing ? ButtonStyle.Success : ButtonStyle.Danger)"
                              Variant="Variant.Text"
                              Click="@ToggleEditing"
                              Disabled="IsNoListSelected"
                              Text="@($"Edit Mode: {(_isEditing ? "ON" : "OFF")}")"/>
                <RadzenButton Click="CreateTaskAsync" Disabled="IsNoListSelected" Icon="add" ButtonStyle="ButtonStyle.Success" Text="Add Task"/>
                <RadzenButton Click="CreateListAsync" Icon="add" ButtonStyle="ButtonStyle.Success" Text="Add List"/>
                <RadzenButton Click="DeleteListAsync" Disabled="IsNoListSelected" ButtonStyle="ButtonStyle.Danger" Icon="@MaterialIcons.Delete" Text="Delete List"/>
                <RadzenButton Click="UpdateListAsync" Disabled="IsNoListSelected" ButtonStyle="ButtonStyle.Warning" Icon="@MaterialIcons.Update" Text="Update List"/>
            <DataGridExportButton DataGrid="_grid" ExcelTitle="@_selectedList.Name" FileName="todo" DisableExportAllScope="@(_count > 999)"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.Name)" Title="Task Name" Width="140px">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <RadzenIcon IconColor="@(context.IsCompleted ? "var(--rz-success)" : "var(--rz-danger)")" Icon="@MaterialIcons.Task"/>
                    }
                    @context.Name
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.DateCreated)" Title="Date Created" Width="160px" FilterValue="DateCreatedFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="DateCreatedFilterValue"/>
            </FilterValueTemplate>
            <Template>
                @context.DateCreated.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.GoalDate)" Title="Goal Date" Width="160px" FilterMode="FilterMode.SimpleWithMenu" FilterValue="GoalDateFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="GoalDateFilterValue"/>
            </FilterValueTemplate>
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <RadzenIcon Icon="@MaterialIcons.Target"/>
                    }
                    @context.GoalDate.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F")
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.DateCompleted)" Title="Date Completed" Width="160px" FilterMode="FilterMode.SimpleWithMenu" FilterValue="DateCompletedFilterValue">
            <FilterValueTemplate>
                <RadzenDatePicker TValue="DateTimeOffset?"
                                  ShowTime
                                  DateFormat="d MMMM yyyy HH:mm:ss"
                                  @bind-Value="DateCompletedFilterValue"/>
            </FilterValueTemplate>
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    @{
                        var isCompletedButFailedToComplete = context is { IsCompleted: true, DateCompleted: not null } && context.GoalDate < context.DateCompleted;
                        var now = DateTimeOffset.UtcNow;
                        @if((isCompletedButFailedToComplete || context.GoalDate < now) && !_isEditing)
                        {
                            <RadzenIcon IconColor="var(--rz-danger)" Icon="@MaterialIcons.Cancel"/>
                        }
                        else if (context.IsCompleted && !_isEditing)
                        {
                            <RadzenIcon IconColor="var(--rz-success)" Icon="@MaterialIcons.CheckCircle"/>
                        }
                        else if (!_isEditing)
                        {
                            <RadzenIcon IconColor="var(--rz-warning)" Icon="indeterminate_question_box"/>
                        }
                        <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                            @(context.DateCompleted?.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString("F") ?? "N/A")
                            @if (isCompletedButFailedToComplete && !_isEditing)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Failed to complete in time (@((context.DateCompleted! - context.GoalDate).Value.Humanize()) late)</RadzenText>
                            }
                            else if (context.GoalDate < now && !_isEditing)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Overdue (@((now - context.GoalDate).Humanize()) late)</RadzenText>
                            }
                        </RadzenStack>
                        <div/>
                    }
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        @if (!_isEditing)
        {
            <RadzenDataGridColumn Property="@nameof(TaskEntry.IsCompleted)" Title="Completed?" TextAlign="TextAlign.Center" Width="75px">
                <Template>
                    <RadzenIcon IconColor="@(context.IsCompleted ? "var(--rz-success)" : "var(--rz-danger)")" Icon="@(context.IsCompleted ? MaterialIcons.CheckCircle : MaterialIcons.Cancel)"/>
                </Template>
            </RadzenDataGridColumn>
        }
        @if (_isEditing)
        {
            <RadzenDataGridColumn Filterable="false" Sortable="false" Width="100px" TextAlign="TextAlign.Center" Frozen="true" Resizable="false">
                <Template>
                    <RadzenButton class="big-icon-button"
                                  ButtonStyle="@(context.IsCompleted ? ButtonStyle.Success : ButtonStyle.Danger)"
                                  Variant="Variant.Text"
                                  Click="_ => OnToggleTaskAsync(context)"
                                  Icon="@(context.IsCompleted ? MaterialIcons.CheckCircle : MaterialIcons.Cancel)"/>
                    <RadzenButton class="big-icon-button"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Warning"
                                  Click="_ => OnEditTaskAsync(context)"
                                  Icon="@MaterialIcons.Edit"/>
                    <RadzenButton class="big-icon-button"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="_ => OnDeleteTaskAsync(context)"
                                  Icon="@MaterialIcons.Delete"/>
                </Template>
            </RadzenDataGridColumn>
        }
    </Columns>
    <FooterTemplate>
        @if (_count > 0)
        {
            <RadzenText Style="@("color:" + (_completedTasks / (double)_count) switch
                               {
                                   >0.0 and <1.0 => "var(--rz-warning)",
                                   >=1.0 => "var(--rz-success)",
                                   _ => "var(--rz-danger)"
                               })" TextAlign="TextAlign.Center">Completed Tasks: @_completedTasks / @_count (@(Math.Round(_completedTasks / (double)_count * 100.0, 2))%)</RadzenText>
        }
    </FooterTemplate>
</RadzenDataGrid>

@code {
    RadzenDataGrid<TaskEntry> _grid = null!;
    bool _isLoading;
    int _count;
    int _completedTasks;
    private bool _isEditing;
    IEnumerable<TaskEntry>? _tasks;
    IList<TaskEntry> _selectedTasks = [];
    TodoList _selectedList = TodoList.None;
    List<TodoList> _lists = [];
    private int _listsCount;
    private bool _isListsDataLoading;
    private Task? _initTask;
    private Guid _userId;
    private bool IsNoListSelected => _selectedList.Id == TodoList.None.Id;

    private static readonly ConfirmOptions ConfirmDeleteOptions = new()
    {
        Icon = MaterialIcons.Delete,
        IconColor = "var(--rz-danger)",
        OkButtonText = "Yes",
        CancelButtonText = "No" 
    };

    DateTimeOffset? DateCreatedFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    DateTimeOffset? GoalDateFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }
    DateTimeOffset? DateCompletedFilterValue
    {
        get;
        set => field = value?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    }

    private void ToggleEditing() => _isEditing = !_isEditing;

    private async Task OnToggleTaskAsync(TaskEntry entry)
    {
        var command = new ToggleTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await ToggleTaskHandler.HandleAsync(command);
        if (message.Type is not MessageType.Success)
            NotificationService.Show(message, duration: RadzenNotificationConstants.ShortDuration);
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task OnDeleteTaskAsync(TaskEntry entry)
    {
        var confirmData = await DialogService.Confirm(
            $"Are you sure you want to delete '{entry.Name}'? You cannot undo this action!", 
            "Confirm Task Deletion", 
            options: ConfirmDeleteOptions);
            
        if (confirmData != true) return;

        var command = new DeleteTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await DeleteTaskHandler.HandleAsync(command);
        NotificationService.Show(message);
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task OnEditTaskAsync(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?>(3)
        {
            [nameof(TaskUpdateDialog.OldEntry)] = entry,
            [nameof(TaskUpdateDialog.ListId)] = _selectedList.Id,
            [nameof(TaskUpdateDialog.ListVersionId)] = _selectedList.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (result is not UpdateTaskCommand command) return;

        var message = await UpdateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(_selectedList.Id);
    }

    private static readonly LoadDataArgs DefaultListsLoadDataArgs = new()
    {
        Skip = 0,
        Top = 5
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var state = await Provider.GetAuthenticationStateAsync();
        if (state.User.UserId is not { } userId
            || state.User.SecurityStamp is not { } securityStamp
            || await UserStore.GetOrSetUserAsync(userId) is not { } user
            || user.SecurityStamp != securityStamp)
        {
            Redirect();
            return;
        }
        _userId = user.Id;
        _initTask = LoadListsAsync(DefaultListsLoadDataArgs);
    }

    private async Task DeleteListAsync()
    {
        var confirmData = await DialogService.Confirm(
            $"Are you sure you want to delete '{_selectedList.Name}'?", 
            "Confirm List Deletion", 
            options: ConfirmDeleteOptions);
            
        if (confirmData != true) return;

        var command = new DeleteListCommand(_selectedList.Id);
        var message = await DeleteListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync();
    }

    private async Task CreateListAsync()
    {
        var result = await DialogService.OpenAsync<ListCreationDialog>("Create List");
        if (result is not CreateListCommand command) return;

        var message = await CreateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(); 
    }

    private async Task CreateTaskAsync()
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(TaskCreationDialog.ListId)] = _selectedList.Id, 
            [nameof(TaskCreationDialog.ListVersionId)] = _selectedList.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (result is not CreateTaskCommand command) return;

        var message = await CreateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(_selectedList.Id);
    }
    
    private async Task RefreshStateAsync(Guid? preferredListId = null)
    {
        await LoadListsAsync(DefaultListsLoadDataArgs);
        
        var listIdToSelect = preferredListId ?? _selectedList.Id;
        _selectedList = _lists.FirstOrDefault(l => l.Id == listIdToSelect) ?? _lists.FirstOrDefault() ?? TodoList.None;
        
        await _grid.Reload();
    }

    private async Task UpdateListAsync()
    {
        var parameters = new Dictionary<string, object?>(1)
        {
            [nameof(ListUpdateDialog.OldList)] = _selectedList
        };
        var result = await DialogService.OpenAsync<ListUpdateDialog>("Update List", parameters);
        if (result is not UpdateListCommand command) return;

        var message = await UpdateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshStateAsync(_selectedList.Id);
    }

    static bool IsNullOrEmpty(FilterOperator? value)
    {
        return value is FilterOperator.IsEmpty or FilterOperator.IsNotEmpty or FilterOperator.IsNull or FilterOperator.IsNotNull;
    }

    void OnListSelected(TodoList newList)
    {
        _selectedList = newList;
        StateHasChanged();
        _grid.FirstPage(forceReload: true);
    }

    void OnFilter(DataGridColumnFilterEventArgs<TaskEntry> args)
    {
        if (IsNullOrEmpty(args.Column?.GetFilterOperator()))
        {
            OnFilterCleared(args);
        }
    }

    private void OnFilterCleared(DataGridColumnFilterEventArgs<TaskEntry> args)
    {
        switch (args.Column?.Property)
        {
            case nameof(TaskEntry.DateCreated):
                DateCreatedFilterValue = null;
                break;
            case nameof(TaskEntry.DateCompleted):    
                DateCompletedFilterValue = null;
                break;
            case nameof(TaskEntry.GoalDate):
                GoalDateFilterValue = null;
                break;
        }
        _grid.Reload();
    }

    private async Task LoadListsAsync(LoadDataArgs args)
    {
        try
        {
            _isListsDataLoading = true;
            await InvokeAsync(StateHasChanged);
            
            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = context.TodoLists
                .AsNoTracking()
                .Where(t => t.UserId == _userId)
                .OrderByDescending(e => e.LastModifiedDate.HasValue)
                .ThenByDescending(e => e.LastModifiedDate)
                .ThenByDescending(e => e.CreationDate)
                .AsQueryable();
            
            if (!string.IsNullOrEmpty(args.Filter))
            {
                query = query.Where(t => t.Name.ToLower().Contains(args.Filter.ToLower()));
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }
            
            _listsCount = await query.CountAsync();
            
            if (args.Skip is not null)
            {
                query = query.Skip(args.Skip.Value);
            }
            
            if (args.Top is not null)
            {
                query = query.Take(args.Top.Value);
            }

            if (_listsCount == 0)
            {
                _lists = [TodoList.None];
            }
            else
            {
                _lists = await query.ToListAsync();
            }
        }
        catch (Exception)
        {
            _lists = [TodoList.None];
            _listsCount = 0;
        }
        finally
        {
            _isListsDataLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        try
        {
            _isLoading = true;
            await InvokeAsync(StateHasChanged);

            if (_initTask is not null)
            {
                await _initTask;
                _initTask = null;
                _selectedList = _lists.FirstOrDefault() ?? TodoList.None;
            }
            
            if (_selectedList.Id == TodoList.None.Id)
            {
                _tasks = [];
                _count = 0;
                _completedTasks = 0;
                return;
            }

            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = context.Tasks
                .AsNoTracking()
                .ForTodoList(_selectedList.Id)
                .OrderByDescending(e => e.DateCreated)
                .AsQueryable();

            if (!string.IsNullOrEmpty(args.Filter))
            {
                query = query.Where(args.Filter);
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }

            _count = await query.CountAsync();
            
            _completedTasks = _count > 0 ? await query.CountAsync(t => t.IsCompleted) : 0;

            if (args.Skip is not null)
            {
                query = query.Skip(args.Skip.Value);
            }
            
            if (args.Top is not null)
            {
                query = query.Take(args.Top.Value);
            }
            
            _tasks = await query.ToListAsync();

            if (_tasks.IsNotEmpty && _selectedTasks.IsEmpty)
            {
                _selectedTasks.Add(_tasks.First());
            }
        }
        catch (Exception)
        {
            _tasks = [];
            _count = 0;
            _completedTasks = 0;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }

    private void Redirect() => NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?returnUrl={ApplicationRoutes.Home}", forceLoad: true);
}
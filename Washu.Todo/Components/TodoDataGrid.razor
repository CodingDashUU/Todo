@using System.Diagnostics
@using System.Globalization
@using Humanizer
@using Mediator
@using Washu.Framework
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Presentation
@using Washu.Framework.Identity.Users
@using Washu.Framework.Notifications
@using Washu.Framework.SharedComponents.Buttons
@using Washu.Framework.SharedComponents
@using Washu.Framework.SharedComponents.DataGrid
@using Washu.Framework.SharedComponents.Notifications
@using Washu.Todo.Extensions
@using Washu.Todo.Tasks
@using Washu.Todo.TodoList
@inject ISender Sender
@inject UserTimeZoneProvider TimeZoneProvider
@inject GetUserService GetUserService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavManager

<RadzenDataGrid @ref="_grid" 
                @bind-Value="@_selectedTasks" 
                TItem="TaskEntry"
                AllowFiltering
                AllowColumnResize
                AllowAlternatingRows 
                AllowSorting
                AllowPaging
                ShowPagingSummary
                PageSize="10"  
                Style="max-height: 77vh"
                FilterMode="FilterMode.SimpleWithMenu" 
                PagerHorizontalAlign="HorizontalAlign.Left"
                SelectionMode="DataGridSelectionMode.Single" 
                IsLoading="@_isLoading"  
                Data="@_tasks" 
                Count="@_count"
                LoadData="@LoadTasksAsync" 
                Filter="FilterHelpers.OnFilter" 
                FilterCleared="FilterHelpers.OnFilterCleared"
                ColumnWidth="300px"
                IsNullText="Is N/A" 
                IsNotNullText="Is not N/A">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenFormField Text="Selected Todo List">
                    <RadzenDropDownDataGrid
                        @ref="_dropDownGrid"
                        Style="width: 600px"
                        TValue="TodoList"
                        Value="@_selectedList"
                        Count="_listsCount"
                        IsLoading="_isListsDataLoading"
                        Data="@_lists"
                        ValueChanged="OnListSelected"
                        LoadData="LoadListsAsync"
                        AllowColumnResize
                        AllowSorting
                        ShowPagingSummary
                        TextProperty="@nameof(TodoList.Name)">
                        <FooterTemplate>
                            <RadzenStack>
                                <AddButton Text="Add List" Outlined Click="CreateListAsync"/>
                            </RadzenStack>
                        </FooterTemplate>
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="@nameof(TodoList.Name)" Title="List Name" Width="100px"/>
                            <RadzenDropDownDataGridColumn Property="@nameof(TodoList.CreationDate)" Title="Created At" Width="100px">
                                <Template>
                                    @ToTimeZoneAndString(((TodoList)context).CreationDate)
                                </Template>
                            </RadzenDropDownDataGridColumn>
                            <RadzenDropDownDataGridColumn Filterable="false" Sortable="false" Width="100px" TextAlign="TextAlign.Center" Frozen="true" Resizable="false">
                                <Template>
                                    <AddButton Click="_ => CreateTaskAsync(context)"/>
                                    <EditButton Click="_ => UpdateListAsync(context)"/>
                                    <DeleteButton Click="_ => DeleteListAsync(context)"/>
                                </Template>
                            </RadzenDropDownDataGridColumn>
                        </Columns>
                    </RadzenDropDownDataGrid>
                </RadzenFormField>
                <ToggleButton 
                    IsOn="_isEditing"
                    Toggle="@ToggleEditing"
                    ButtonOnText="Edit Mode: ON"
                    ButtonOffText="Edit Mode: OFF"
                    IsDisabled="IsNoListSelected"/>
            <DataGridExportButton DataGrid="_grid" ExcelTitle="@_selectedList.Name" FileName="todo" DisableExportAllScope="@(_count > 999)"/>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(TaskEntry.Name)" Title="Task Name" Width="140px">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <IconColourToggle Icon="@MaterialIcons.Task" IsOn="context.IsCompleted"/>
                    }
                    @context.Name
                </RadzenStack>
            </Template>
        </RadzenDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.DateCreated)" Title="Date Created" Width="160px">
            <Template>
                @ToTimeZoneAndString(context.DateCreated)
            </Template>
        </DateTimeOffsetDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.GoalDate)" Title="Goal Date" Width="160px" FilterMode="FilterMode.SimpleWithMenu">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.1rem">
                    @if (!_isEditing)
                    {
                        <RadzenIcon Icon="@MaterialIcons.Target"/>
                    }
                    @ToTimeZoneAndString(context.GoalDate)
                </RadzenStack>
            </Template>
        </DateTimeOffsetDataGridColumn>
        <DateTimeOffsetDataGridColumn Property="@nameof(TaskEntry.DateCompleted)" Title="Date Completed" Width="160px" FilterMode="FilterMode.SimpleWithMenu">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    @{
                        var now = DateTimeOffset.UtcNow;
                        var state = context.DetermineCompletionState(now);
                        if (!_isEditing)
                        {
                            switch (state)
                            {
                                case TaskCompletionState.Completed:
                                    <RadzenIcon IconColor="var(--rz-success)" Icon="@MaterialIcons.CheckCircle"/>
                                    break;
                                case TaskCompletionState.NotCompletedInTime or TaskCompletionState.Overdue:
                                    <RadzenIcon IconColor="var(--rz-danger)" Icon="@MaterialIcons.Cancel"/>
                                    break;
                                default:
                                    <RadzenIcon IconColor="var(--rz-warning)" Icon="@MaterialIcons.QuestionBox"/>
                                    break;
                            }   
                        }
                        <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                            @(context.DateCompleted.HasValue ? ToTimeZoneAndString(context.DateCompleted.Value) : "N/A")
                            @if (!_isEditing)
                            {
                                switch (state)
                                {
                                    case TaskCompletionState.NotCompletedInTime:
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Failed to complete in time (@((context.DateCompleted! - context.GoalDate).Value.Humanize()) late)</RadzenText>
                                        break;
                                    case TaskCompletionState.Overdue:
                                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">Overdue (@((now - context.GoalDate).Humanize()) late)</RadzenText>
                                        break;
                                }
                            }
                        </RadzenStack>
                        <div/>
                    }
                </RadzenStack>
            </Template>
        </DateTimeOffsetDataGridColumn>
        @if (!_isEditing)
        {
            <RadzenDataGridColumn Property="@nameof(TaskEntry.IsCompleted)" Title="Completed?" TextAlign="TextAlign.Center" Width="75px">
                <Template>
                    <IconToggle IsOn="context.IsCompleted"/>
                </Template>
            </RadzenDataGridColumn>
        }
        @if (_isEditing)
        {
            <RadzenDataGridColumn Filterable="false" Sortable="false" Width="100px" TextAlign="TextAlign.Center" Frozen="true" Resizable="false">
                <Template>
                    <IconToggleButton IsOn="context.IsCompleted" Toggle="_ => OnToggleTaskAsync(context)" />
                    <EditButton Click="_ => OnEditTaskAsync(context)" />
                    <DeleteButton Click="_ => OnDeleteTaskAsync(context)"/>
                </Template>
            </RadzenDataGridColumn>
        }
    </Columns>
    <FooterTemplate>
        @if (_count > 0)
        {
            var percentage = new Percentage(_completedTasks / (double)_count);
            <RadzenText Style="@("color:" + percentage.Hue)" TextAlign="TextAlign.Center">
                Completed Tasks: @_completedTasks / @_count (@percentage.ToString(decimalPlaces: 2))
            </RadzenText>
        }
    </FooterTemplate>
</RadzenDataGrid>

@code {
    RadzenDataGrid<TaskEntry> _grid = null!;
    RadzenDropDownDataGrid<TodoList> _dropDownGrid = null!;
    bool _isLoading;
    int _count;
    int _completedTasks;
    private bool _isEditing;
    IEnumerable<TaskEntry>? _tasks;
    IList<TaskEntry> _selectedTasks = [];
    TodoList _selectedList = TodoList.None;
    List<TodoList> _lists = [];
    private int _listsCount;
    private bool _isListsDataLoading;
    private Task? _initTask;
    private long _tasksLoadVersion;
    private bool IsNoListSelected => _selectedList.Id == TodoList.None.Id;
    private DataGridFilterHelpers<TaskEntry> FilterHelpers => new(_grid);
    private void ToggleEditing() => _isEditing = !_isEditing;
    private string ToTimeZoneAndString(DateTimeOffset date) => date.ToTimeZone(TimeZoneProvider.TimeZoneInfo).ToString(DataGridConstants.DateTimeFormat, CultureInfo.InvariantCulture);
    private static bool IsSessionError(Error error) => error is UserNotFoundError or UserIdNotFoundError;
    private void RedirectToSignIn() => NavManager.NavigateTo(ApplicationRoutes.SignIn, forceLoad: true);

    private async Task OnToggleTaskAsync(TaskEntry entry)
    {
        var command = new ToggleTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var result = await Sender.Send(command);
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        if (result is Error err)
            NotificationService.Show(Message.Error("Toggle Task Error", err.Message), duration: RadzenNotificationConstants.ShortDuration);
        
        await RefreshStateAsync(_selectedList.Id);
    }
   
    private async Task OnDeleteTaskAsync(TaskEntry entry)
    {
        var confirmData = await DialogService.ConfirmDelete(
            "Confirm Task Deletion",
            $"Are you sure you want to delete {entry.Name}? You cannot undo this action!");
            
        if (!confirmData) return;

        var command = new DeleteTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var result = await Sender.Send(command);
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        NotificationService.Show(result switch
        {
            UnitValue => Message.Success("Delete Task", "Successfully deleted task"),
            Error err => Message.Error("Delete Task Error", err.Message),
            null => throw new UnreachableException()
        });
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task OnEditTaskAsync(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(TaskUpdateDialog.OldEntry)] = entry,
            [nameof(TaskUpdateDialog.List)] = _selectedList
        };
        var data = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (data is not Result result) return;
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        NotificationService.Show(result switch
        {
            UnitValue => Message.Success("Update Task", "Successfully edited task"),
            Error err => Message.Error("Update Task Error", err.Message),
            null => throw new UnreachableException()
        });
        
        await RefreshStateAsync(_selectedList.Id);
    }
    
    private static readonly LoadDataArgs DefaultListsLoadDataArgs = new()
    {
        Skip = 0,
        Top = 5
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await GetUserService.GetOrRedirectAsync();
        _initTask = LoadListsAsync(DefaultListsLoadDataArgs);
    }

    private async Task DeleteListAsync(TodoList list)
    {
        var confirmData = 
        await DialogService.ConfirmDelete("Confirm List Deletion", $"Are you sure you want to delete '{list.Name}'?");
            
        if (!confirmData) return;

        var command = new DeleteListCommand(list.Id);
        var result = await Sender.Send(command);
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        NotificationService.Show(result switch
        {
            UnitValue => Message.Success("Delete List", "Successfully deleted list"),
            Error err => Message.Error("Delete List Error", err.Message),
            null => throw new UnreachableException()
        });
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task CreateListAsync()
    {
        var data = await DialogService.OpenAsync<ListCreationDialog>("Create List");
        if (data is not Result result) return;
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        NotificationService.Show(result switch
        {
            UnitValue => Message.Success("Create List", "Successfully created list"),
            Error err => Message.Error("Create List Error", err.Message),
            null => throw new UnreachableException()
        });
        
        await RefreshStateAsync(_selectedList.Id);
    }

    private async Task CreateTaskAsync(TodoList list)
    {
        var parameters = new Dictionary<string, object?>(1)
        {
            [nameof(TaskCreationDialog.List)] = list
        };
        var data = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (data is not Result result) return;
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        var message = result switch
        {
            Error e => Message.Error("Create Task Error", e.Message),
            UnitValue => Message.Success("Create Task Success", "Successfully created task"),
            null => throw new UnreachableException()
        };
        NotificationService.Show(message);

        await RefreshStateAsync(list.Id);
    }
    
    private async Task RefreshStateAsync(Guid? preferredListId = null)
    {
        await _dropDownGrid.Reload();
        
        var listIdToSelect = preferredListId ?? _selectedList.Id;
        _selectedList = _lists.FirstOrDefault(l => l.Id == listIdToSelect) ?? _lists.FirstOrDefault() ?? TodoList.None;
        _selectedTasks.Clear();
        
        await _grid.Reload();
    }

    private async Task UpdateListAsync(TodoList list)
    {
        var parameters = new Dictionary<string, object?>(1)
        {
            [nameof(ListUpdateDialog.OldList)] = list
        };
        var data = await DialogService.OpenAsync<ListUpdateDialog>("Update List", parameters);
        if (data is not Result result) return;
        if (result is Error error && IsSessionError(error))
        {
            RedirectToSignIn();
            return;
        }
        var message = result switch
        {
            Error e => Message.Error("Update List Error", e.Message),
            UnitValue => Message.Success("Update List Success", "Successfully updated list"),
            null => throw new UnreachableException()
        };
        NotificationService.Show(message);

        await RefreshStateAsync(list.Id);
    }

    void OnListSelected(TodoList newList)
    {
        _selectedList = newList;
        _selectedTasks.Clear();
        _grid.FirstPage(forceReload: true);
    }

    private async Task LoadListsAsync(LoadDataArgs args)
    {
        try
        {
            _isListsDataLoading = true;
            var result = await Sender.Send(new GetListsQuery(LoadDataConfig.FromRadzenArgs(args)));
            switch (result)
            {
                case GetListsResponse response:
                    _lists = response.Lists;
                    _listsCount = response.Count;
                    break;
                case UserIdNotFoundError or UserNotFoundError:
                    RedirectToSignIn();
                    break;
                case Error error:
                    _lists = [];
                    _listsCount = 0;
                    NotificationService.Show(Message.Error("Load Lists Error", error.Message));
                    break;
            }
        }
        catch (Exception)
        {
            _lists = [];
            _listsCount = 0;
            NotificationService.Show(Message.Error("Load Lists Error", "Unable to load your todo lists. Please try again."));
        }
        finally
        {
            _isListsDataLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }

    private async Task LoadTasksAsync(LoadDataArgs args)
    {
        var loadVersion = ++_tasksLoadVersion;
        try
        {
            _isLoading = true;
            await InvokeAsync(StateHasChanged);

            if (_initTask is not null)
            {
                await _initTask;
                _initTask = null;
                _selectedList = _lists.FirstOrDefault() ?? TodoList.None;
            }
            
            if (_selectedList.Id == TodoList.None.Id)
            {
                if (loadVersion != _tasksLoadVersion) return;
                _tasks = [];
                _count = 0;
                _completedTasks = 0;
                return;
            }

            var selectedListId = _selectedList.Id;
            var result = await Sender.Send(new GetTasksQuery(selectedListId, LoadDataConfig.FromRadzenArgs(args)));
            if (loadVersion != _tasksLoadVersion || _selectedList.Id != selectedListId) return;

            switch (result)
            {
                case Error error:
                    if (IsSessionError(error)) RedirectToSignIn();
                    else NotificationService.Show(Message.Error("Load Tasks Error", error.Message));
                    _tasks = [];
                    _count = 0;
                    _completedTasks = 0;
                    return;
                case GetTasksResponse response:
                    _tasks = response.Tasks;
                    _count = response.Count;
                    _completedTasks = response.CompletedTasks;
                    break;
                default:
                    throw new UnreachableException();
            }

            if (_tasks.IsNotEmpty && _selectedTasks.IsEmpty)
            {
                _selectedTasks.Add(_tasks.First());
            }
        }
        catch (Exception)
        {
            if (loadVersion != _tasksLoadVersion) return;
            _tasks = [];
            _count = 0;
            _completedTasks = 0;
            NotificationService.Show(Message.Error("Load Tasks Error", "Unable to load your tasks. Please try again."));
        }
        finally
        {
            if (loadVersion == _tasksLoadVersion) _isLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
}

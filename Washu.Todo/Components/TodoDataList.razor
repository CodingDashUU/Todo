@using Microsoft.EntityFrameworkCore
@using Washu.Todo.Identity
@using Dialogs
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Features
@inject NavigationManager NavManager
@inject ApplicationUserStore UserStore
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject CreateListHandler CreateListHandler
@inject CreateTaskHandler CreateTaskHandler
@inject ToggleTaskHandler ToggleTaskHandler
@inject UpdateTaskHandler UpdateTaskHandler
@inject UpdateListHandler UpdateListHandler
@inject DeleteTaskHandler DeleteTaskHandler
@inject DeleteListHandler DeleteListHandler

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenCard>
        <RadzenDropDownDataGrid 
            TValue="TodoList"
            Value="@_selectedList" 
            Count="_listsCount"
            IsLoading="_isListsDataLoading"
            Data="@_lists"
            ValueChanged="OnListSelected"
            LoadData="LoadListsAsync"
            TextProperty="@nameof(TodoList.Name)"
            />
        <RadzenButton class="big-icon-button"
                      ButtonStyle="@(_isEditing ? ButtonStyle.Success : ButtonStyle.Danger)"
                      Variant="Variant.Text"
                      Click="@ToggleEditing"
                      Disabled="IsNoListSelected"
                      Text="@($"Edit Mode: {(_isEditing ? "ON" : "OFF")}")" />

        <RadzenButton class="big-icon-button"
                      ButtonStyle="@(_isDeleting ? ButtonStyle.Success : ButtonStyle.Danger)"
                      Variant="Variant.Text"
                      Click="@ToggleDeleting"
                      Disabled="IsNoListSelected"
                      Text="@($"Delete Mode: {(_isDeleting ? "ON" : "OFF")}")" />
                  
        <RadzenButton Click="CreateTaskAsync" Disabled="IsNoListSelected">Add Task</RadzenButton>
        <RadzenButton Click="CreateListAsync">Add List</RadzenButton>
        <RadzenButton Click="DeleteListAsync" Disabled="IsNoListSelected">Delete List</RadzenButton>
        <RadzenButton Click="UpdateListAsync" Disabled="IsNoListSelected">Update List</RadzenButton>
    </RadzenCard>
</RadzenStack>

<RadzenDataList @ref="_dataList"
                WrapItems AllowPaging IsLoading="@_isTasksDataLoading"
                LoadData="@LoadTasksAsync"
                Style="height:580px;overflow:auto"
                Data="@_tasks" Count="_tasksCount" TItem="TaskEntry" 
                PageSize="TasksPageCount" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary>
    <Template Context="item">
        <TaskCard Entry="item"
                  OnTaskCompleted="() => OnToggleTask(item)" 
                  IsEditing="_isEditing" 
                  IsDeleting="_isDeleting"
                  OnDeleteClicked="() => DeleteTaskAsync(item)"
                  OnSettingsClicked="() => OnSettingsClicked(item)" />
    </Template>
</RadzenDataList>

@code {
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }

    private Guid _userId;
    private static readonly ConfirmOptions ConfirmDeleteOptions = new()
    {
        Icon = MaterialIcons.Delete,
        IconColor = "var(--rz-danger)",
        OkButtonText = "Yes",
        CancelButtonText = "No" 
    };
    private const byte TasksPageCount = 10;
    private RadzenDataList<TaskEntry>? _dataList;
    private bool _isEditing;
    private bool _isDeleting;
    
    private bool _hasInitialized; 
    
    private bool IsNoListSelected => _selectedList.Id == TodoList.None.Id;
    
    private TodoList _selectedList = TodoList.None;
    private IList<TaskEntry> _tasks = [];
    private List<TodoList> _lists = [];
    private bool _isTasksDataLoading;
    private bool _isListsDataLoading;
    private int _tasksCount;
    private int _listsCount;

    private static readonly LoadDataArgs DefaultListsLoadDataArgs = new()
    {
        Skip = 0,
        Top = 5
    };
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var state = await Context;
        if (state.User.UserId is not { } userId
            || state.User.SecurityStamp is not { } securityStamp
            || await UserStore.GetOrSetUserAsync(userId) is not { } user
            || user.SecurityStamp != securityStamp)
        {
            Redirect();
            return;
        }
        _userId = user.Id;
        await LoadListsAsync(DefaultListsLoadDataArgs);
        _selectedList = _lists.FirstOrDefault() ?? Todo.TodoList.None;
        await FetchTasksAsync(skip: 0, top: TasksPageCount);
        _hasInitialized = true;
    }

    private void ToggleEditing() => _isEditing = !_isEditing;
    private void ToggleDeleting() => _isDeleting = !_isDeleting;

    private async Task OnListSelected(TodoList newList)
    {
        _selectedList = newList.Id == TodoList.None.Id ? TodoList.None : newList;
        if (_dataList is not null)
        {
            await _dataList.FirstPage(true);
        }
    }
    private async Task LoadListsAsync(LoadDataArgs args)
    {
        try
        {
            _isListsDataLoading = true;
            await InvokeAsync(StateHasChanged);
            
            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = context.TodoLists
                .AsNoTracking()
                .Where(t => t.UserId == _userId)
                .OrderByDescending(e => e.LastModifiedDate.HasValue)
                .ThenByDescending(e => e.LastModifiedDate)
                .AsQueryable();
            
            if (!string.IsNullOrEmpty(args.Filter))
            {
                query = query.Where(t => t.Name.ToLower().Contains(args.Filter.ToLower()));
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }
            _listsCount = await query.CountAsync();
            if (args.Skip is not null)
            {
                query = query.Skip(args.Skip.Value);
            }
            if (args.Top is not null)
            {
                query = query.Take(args.Top.Value);
            }

            if (_listsCount == 0)
            {
                _lists = [TodoList.None];
            }

            _lists = await query.ToListAsync();
        }
        catch (Exception)
        {
            _lists = [];
            _listsCount = 0;
        }
        finally
        {
            _isListsDataLoading = false;
            await InvokeAsync(StateHasChanged); 
        }
    }
    private async Task FetchTasksAsync(int skip, int top)
    {
        if (_selectedList.Id == TodoList.None.Id)
        {
            _tasks = [];
            _tasksCount = 0;
            return;
        }

        try
        {
            _isTasksDataLoading = true;
            await using var context = await DbContextFactory.CreateDbContextAsync();
            var query = context.Tasks
                .AsNoTracking()
                .ForTodoList(_selectedList.Id)
                .OrderByDescending(e => e.DateCreated)
                .AsQueryable();
            
            _tasksCount = await query.CountAsync();
            _tasks = await query.Skip(skip).Take(top).ToListAsync();
        }
        catch (Exception)
        {
            _tasks = [];
            _tasksCount = 0;
        }
        finally
        {
            _isTasksDataLoading = false;
        }
    }

    private async Task LoadTasksAsync(LoadDataArgs args)
    {
        if (!_hasInitialized) return;

        await FetchTasksAsync(args.Skip ?? 0, args.Top ?? TasksPageCount);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshCurrentListAsync()
    {
        await LoadListsAsync(DefaultListsLoadDataArgs);
        if (_dataList is not null)
        {
            await _dataList.Reload();
        }
        _selectedList = _lists.FirstOrDefault() ?? TodoList.None;
    }

    private async Task DeleteTaskAsync(TaskEntry entry)
    {
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete this task? You cannot undo this action!", 
            "Confirm Task Deletion", 
            options: ConfirmDeleteOptions);
        if (!confirmData.HasValue || !confirmData.Value) return;

        var command = new DeleteTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await DeleteTaskHandler.HandleAsync(command);
        NotificationService.Show(message);
        
        await RefreshCurrentListAsync();
    }

    private async Task CreateTaskAsync()
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(TaskCreationDialog.ListId)] = _selectedList.Id, 
            [nameof(TaskCreationDialog.ListVersionId)] = _selectedList.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (result is not CreateTaskCommand command) return;

        var message = await CreateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshCurrentListAsync();
    }
    private async Task UpdateListAsync()
    {
        var parameters = new Dictionary<string, object?>(1)
        {
            [nameof(ListUpdateDialog.OldList)] = _selectedList
        };
        var result = await DialogService.OpenAsync<ListUpdateDialog>("Update List", parameters);
        if (result is not UpdateListCommand command) return;

        var message = await UpdateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshCurrentListAsync();
    }


    private async Task OnToggleTask(TaskEntry entry)
    {
        var command = new ToggleTaskCommand(entry.Id, _selectedList.Id, _selectedList.RowVersion);
        var message = await ToggleTaskHandler.HandleAsync(command);
        NotificationService.Show(message, duration: RadzenNotificationConstants.ShortDuration);

        await RefreshCurrentListAsync();
    }

    private async Task OnSettingsClicked(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?>(3)
        {
            [nameof(TaskUpdateDialog.OldEntry)] = entry,
            [nameof(TaskUpdateDialog.ListId)] = _selectedList.Id,
            [nameof(TaskUpdateDialog.ListVersionId)] = _selectedList.RowVersion
        };
        var result = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (result is not UpdateTaskCommand command) return;

        var message = await UpdateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshCurrentListAsync();
    }

    private async Task DeleteListAsync()
    {
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete this list?", 
            "Confirm List Deletion", 
            options: ConfirmDeleteOptions);
        if (!confirmData.HasValue || !confirmData.Value) return;

        var command = new DeleteListCommand(_selectedList.Id);
        var message = await DeleteListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshCurrentListAsync();
    }

    private async Task CreateListAsync()
    {
        var result = await DialogService.OpenAsync<ListCreationDialog>("Create List");
        if (result is not CreateListCommand command) return;

        var message = await CreateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await RefreshCurrentListAsync();
    }
    private void Redirect() => NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?returnUrl={ApplicationRoutes.Home}", forceLoad: true);
}
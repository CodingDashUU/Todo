@using Washu.Framework.Constants
@inject NavigationManager NavManager
@attribute [Route(ApplicationRoutes.NotFound)]
@layout MainLayout
<PageTitle>Not Found</PageTitle>
<RadzenCard class="rz-my-12 rz-mx-auto rz-p-8" style="max-width: 450px;">
    <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem" class="rz-text-align-center">
        <RadzenIcon Icon="search_off" Style="font-size: 3rem; color: var(--rz-text-color-3);" />
        
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.DisplayH4">Not Found</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                Sorry, the content you are looking for does not exist.
            </RadzenText>
        </RadzenStack>

        <RadzenButton Text="Go back" 
                      Icon="@MaterialIcons.ArrowBack" 
                      ButtonStyle="ButtonStyle.Light" 
                      Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Home))" />
    </RadzenStack>
</RadzenCard>
@using Washu.Framework.Notifications
@using Washu.Framework.Radzen
@inject MessageStore Store
@inject RadzenNotificationService NotificationService
@code {
    [SupplyParameterFromQuery] public string ErrorId { get; set; } = "";

    protected void ShowErrorMessage()
    {
        if (string.IsNullOrEmpty(ErrorId)) return;
        foreach (var error in Store.Take(ErrorId))
        {
            NotificationService.NotifyMessage(new Message
            {
                Title = error.Title,
                Details = error.Details,
                Type = error.Type,
            }
                );
            Task.Delay(4000);
        }
    }
}
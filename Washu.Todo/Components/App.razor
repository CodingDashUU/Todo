@using Microsoft.Extensions.Options
@using Washu.Framework.AspNetCore
@using Washu.Framework.Constants
@inject ThemeService ThemeService
@inject IOptions<CookieThemeServiceOptions> Options

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Washu.Todo.styles.css"]"/>
    <link rel="stylesheet" href="_content/Washu.Framework/styles.css"/>
    <ImportMap/>
    <HeadOutlet @rendermode="InteractiveServer" />
    <RadzenTheme Theme="material"/>
</head>
<body>
<ReconnectModal/>
<script>
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        document.cookie = `@CookieNames.ClientTimeZone=${tz}; path=/; max-age=31536000; samesite=lax; Secure`;
    </script>
<script>
    window.setThemeCookie = function (value) {
        const date = new Date();
        date.setTime(date.getTime() + (365 * 24 * 60 * 60 * 1000));
        const expires = "; expires=" + date.toUTCString();
        document.cookie = `@CookieNames.Theme=${value || "light"}${expires}; path=/; SameSite=Lax; Secure`;
    };
</script>
<Routes @rendermode="InteractiveServer"/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var themeFound = HttpContext.Request.Cookies[CookieNames.Theme];
        var isLight = themeFound?.Equals("light", StringComparison.OrdinalIgnoreCase) ?? false;
        var isDark = themeFound?.Equals("dark", StringComparison.OrdinalIgnoreCase) ?? false;
        if (!string.IsNullOrEmpty(themeFound) && (isLight || isDark))
        {
            string theme;
            if (isLight)
                theme = "material";
            else if (isDark)
                theme = "material-dark";
            else theme = "material";
            ThemeService.SetTheme(theme);
        }
        else HttpContext.Response.Cookies.Append(CookieNames.Theme, "light" , new CookieOptions { SameSite=SameSiteMode.Lax ,Secure = Options.Value.IsSecure, Expires = DateTimeOffset.Now.Add(Options.Value.Duration) });    
    }
}
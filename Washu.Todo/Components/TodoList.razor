@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Washu.Framework.Identity
@using Washu.Framework.Notifications
@using Washu.Todo.Commands
@using Washu.Todo.Identity
@using Dialogs
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Entities
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject DialogService DialogService
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject CreateList.Command CreateListCommand
@inject CreateTask.Command CreateTaskCommand
@inject ToggleTask.Command ToggleTaskCommand
@inject UpdateTask.Command UpdateTaskCommand
@inject MessageStore MessageStore
@inject ApplicationUserManager<TodoDbContext> UserManager
<RadzenDropDown TValue="Todo.TodoList" 
                    Value="SelectedList" 
                    Data="ListNames" 
                    TextProperty="Name"
                    PageSize="10" 
                    ValueChanged="OnListSelected" />
    
    <RadzenButton class="big-icon-button"
                  ButtonStyle="@(IsEditing ? ButtonStyle.Success : ButtonStyle.Danger)"
                  Variant="Variant.Text"
                  Click="() => IsEditing = !IsEditing"
                  Disabled="IsNoListSelected"
                  Text="@($"Edit Mode: {(IsEditing ? "ON" : "OFF")}")" />
                  
    <RadzenButton Click="AddTaskAsync" Disabled="IsNoListSelected">Add Task</RadzenButton>
    <RadzenButton Click="CreateListAsync">Add List</RadzenButton>

    @if (IsNoListSelected)
    {
        <RadzenText>No list selected</RadzenText>
    }
    else
    {
        @foreach (var item in SelectedList.Tasks)
        {
            <TaskCard Entry="item" 
                      OnTaskCompleted="() => OnToggleTask(item)" 
                      IsEditing="IsEditing" 
                      OnSettingsClicked="() => OnSettingsClicked(item)" />
        }
    }

@code {
    private ApplicationUser _currentUser = null!;

    public bool IsEditing { get; set; }
    [Parameter] public required ClaimsPrincipal Principal { get; set; }
    
    public Todo.TodoList SelectedList { get; set; } = Todo.TodoList.None;
    public List<Todo.TodoList> ListNames { get; set; } = [];

    private bool IsNoListSelected => SelectedList.Id == Todo.TodoList.None.Id;

    protected override async Task OnInitializedAsync()
    {
        if (Principal.Identity is null || Principal.FindUserId() is not { } userId)
        {
            NavManager.NavigateTo(ApplicationRoutes.SignIn, forceLoad: true);
            return;
        }
        var user = await UserManager.FindByIdAsync(userId);
        if (user is null)
        {
            var id = MessageStore.Store(Message.Error("Identity Error", "User couldn't be found, doesn't exist, or the session is invalid"));
            NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?messageId={id}", forceLoad: true);
            return;
        }
        _currentUser = user;
        await LoadListsAsync(selectDefault: true);
    }
    
    private async Task LoadListsAsync(Guid? preferredSelectedId = null, bool selectDefault = false)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        
        var fetchedLists = await dbContext.GetListsByUserIdAsync(_currentUser.Id);
        
        ListNames = [Todo.TodoList.None, ..fetchedLists];

        if (preferredSelectedId.HasValue)
        {
            SelectedList = ListNames.FirstOrDefault(l => l.Id == preferredSelectedId.Value) ?? Todo.TodoList.None;
        }
        else if (selectDefault)
        {
            SelectedList = ListNames.Where(l => l.Id != Todo.TodoList.None.Id)
                                    .OrderByDescending(l => l.LastModified)
                                    .FirstOrDefault() ?? Todo.TodoList.None;
        }
        StateHasChanged();
    }

    private void OnListSelected(Todo.TodoList newList)
    {
        SelectedList = newList;
        StateHasChanged();
    }

    private async Task CreateListAsync()
    {
        var result = await DialogService.OpenAsync<ListCreationDialog>("Create List");
        if (result is not CreateList.Model model) return;

        var message = await CreateListCommand.ExecuteAsync(_currentUser.Id, model);
        NotificationService.Show(message);

        await LoadListsAsync(selectDefault: true);
    }

    private async Task AddTaskAsync()
    {
        var parameters = new Dictionary<string, object?> { { nameof(TaskCreationDialog.List), SelectedList } };
        var result = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (result is not CreateTask.Model model) return;

        var (message, newList) = await CreateTaskCommand.ExecuteAsync(SelectedList, model);
        NotificationService.Show(message);

        await LoadListsAsync(preferredSelectedId: newList?.Id ?? SelectedList.Id);
    }

    private async Task OnToggleTask(TaskEntry entry)
    {
        var (message, newList) = await ToggleTaskCommand.ExecuteAsync(SelectedList, entry, _currentUser);
        NotificationService.Show(message, duration: RadzenNotificationConstants.ShortDuration);

        await LoadListsAsync(preferredSelectedId: newList?.Id ?? SelectedList.Id);
    }

    private async Task OnSettingsClicked(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?> {  [nameof(TaskUpdateDialog.OldEntry)] = entry };
        var result = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (result is not UpdateTask.Model model) return;

        var (message, newList) = await UpdateTaskCommand.ExecuteAsync(model, SelectedList, entry);
        NotificationService.Show(message);

        await LoadListsAsync(preferredSelectedId: newList?.Id ?? SelectedList.Id);
    }
}
@using Microsoft.EntityFrameworkCore
@using Washu.Framework.Identity
@using Washu.Framework.Notifications
@using Washu.Todo.Identity
@using Dialogs
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Entities
@using Washu.Todo.Features
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject DialogService DialogService
@inject IDbContextFactory<TodoDbContext> DbContextFactory
@inject CreateListHandler CreateListHandler
@inject CreateTaskHandler CreateTaskHandler
@inject ToggleTaskHandler ToggleTaskHandler
@inject UpdateTaskHandler UpdateTaskHandler
@inject DeleteTaskHandler DeleteTaskHandler
@inject DeleteListHandler DeleteListHandler
@inject MessageStore MessageStore
@inject ApplicationUserStore UserStore

<RadzenStack Orientation="Orientation.Horizontal">
    <RadzenCard>
        <RadzenDropDown TValue="Todo.TodoList" 
                        Value="_selectedList" 
                        Data="_listNames" 
                        TextProperty="Name"
                        PageSize="10" 
                        ValueChanged="OnListSelected" />
    
        <RadzenButton class="big-icon-button"
                      ButtonStyle="@(_isEditing ? ButtonStyle.Success : ButtonStyle.Danger)"
                      Variant="Variant.Text"
                      Click="@ToggleEditing"
                      Disabled="IsNoListSelected"
                      Text="@($"Edit Mode: {(_isEditing ? "ON" : "OFF")}")" />

        <RadzenButton class="big-icon-button"
                      ButtonStyle="@(_isDeleting ? ButtonStyle.Success : ButtonStyle.Danger)"
                      Variant="Variant.Text"
                      Click="@ToggleDeleting"
                      Disabled="IsNoListSelected"
                      Text="@($"Delete Mode: {(_isDeleting ? "ON" : "OFF")}")" />
                  
        <RadzenButton Click="CreateTaskAsync" Disabled="IsNoListSelected">Add Task</RadzenButton>
        <RadzenButton Click="CreateListAsync">Add List</RadzenButton>
        <RadzenButton Click="DeleteListAsync" Disabled="IsNoListSelected">Delete List</RadzenButton>
    </RadzenCard>
</RadzenStack>
    @if (IsNoListSelected)
    {
        <RadzenText>No list selected</RadzenText>
    }
    else
    {
        @foreach (var item in _selectedList.Tasks)
        {
            <TaskCard Entry="item" 
                      OnTaskCompleted="() => OnToggleTask(item)" 
                      IsEditing="_isEditing" 
                      IsDeleting="_isDeleting"
                      OnDeleteClicked="() => DeleteTaskAsync(item)"
                      OnSettingsClicked="() => OnSettingsClicked(item)" />
        }
    }


@code {
    private static readonly ConfirmOptions ConfirmDeleteOptions = new()
    {
        Icon = MaterialIcons.Delete,
        IconColor = "var(--rz-danger)",
        OkButtonText = "Yes",
        CancelButtonText = "No" 
    };

    private Guid _userId;
    private bool _isEditing;
    private bool _isDeleting;
    private bool IsNoListSelected => _selectedList.Id == Todo.TodoList.None.Id;
    
    private Todo.TodoList _selectedList = Todo.TodoList.None;
    private List<Todo.TodoList> _listNames = [];
    
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        var principal = await Context;
        if (principal.User.Identity is null || principal.User.UserId is not { } userId)
        {
            NavManager.NavigateTo(ApplicationRoutes.SignIn, forceLoad: true);
            return;
        }

        var user = await UserStore.GetOrAddUserAsync(userId);
        if (user is null)
        {
            var id = MessageStore.Store(Message.Error("Identity Error", "User couldn't be found, doesn't exist, or the session is invalid"));
            NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?messageId={id}", forceLoad: true);
            return;
        }
        _userId = user.Id;
        await LoadListsAsync(selectDefault: true);
    }

    private void ToggleEditing() => _isEditing = !_isEditing;
    private void ToggleDeleting() => _isDeleting = !_isDeleting;

    private async Task DeleteTaskAsync(TaskEntry entry)
    {
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete this task? You cannot undo this action!", 
            "Confirm Task Deletion", 
            options: ConfirmDeleteOptions);
        if (!confirmData.HasValue || !confirmData.Value) return;

        var command = new DeleteTaskCommand(entry.Id, _selectedList.Id, _selectedList.VersionId);
        var message = await DeleteTaskHandler.HandleAsync(command);
        NotificationService.Show(message);
        await LoadListsAsync(preferredSelectedId: _selectedList.Id);
    }

    private async Task LoadListsAsync(Guid? preferredSelectedId = null, bool selectDefault = false)
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        
        var fetchedLists = await dbContext.TodoLists
            .AsNoTracking()
            .Where(l => l.UserId == _userId)
            .OrderByDescending(l => l.LastModified)
            .ToListAsync();
        
        _listNames = new List<Todo.TodoList>(fetchedLists.Count + 1) { Todo.TodoList.None };
        _listNames.AddRange(fetchedLists);

        var targetId = Todo.TodoList.None.Id;
        if (preferredSelectedId.HasValue)
        {
            targetId = _listNames.FirstOrDefault(l => l.Id == preferredSelectedId.Value)?.Id ?? Todo.TodoList.None.Id;
        }
        else if (selectDefault)
        {
            targetId = _listNames.Where(l => l.Id != Todo.TodoList.None.Id)
                                .OrderByDescending(l => l.LastModified)
                                .FirstOrDefault()?.Id ?? Todo.TodoList.None.Id;
        }
        if (targetId != Todo.TodoList.None.Id)
        {
            _selectedList = await dbContext.TodoLists
                .AsNoTracking()
                .Include(l => l.Tasks.OrderBy(t => t.DateCreated))
                .FirstOrDefaultAsync(l => l.Id == targetId) ?? Todo.TodoList.None;
        }
        else
        {
            _selectedList = Todo.TodoList.None;
        }

        StateHasChanged();
    }

    private async Task OnListSelected(Todo.TodoList newList)
    {
        if (newList.Id == Todo.TodoList.None.Id)
        {
            _selectedList = Todo.TodoList.None;
        }
        else
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            _selectedList = await dbContext.TodoLists
                .AsNoTracking()
                .Include(l => l.Tasks.OrderBy(t => t.DateCreated))
                .FirstOrDefaultAsync(l => l.Id == newList.Id) ?? Todo.TodoList.None;
        }
        StateHasChanged();
    }

    private async Task DeleteListAsync()
    {
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete this list? You cannot undo this action!", 
            "Confirm List Deletion", 
            options: ConfirmDeleteOptions);
        if (!confirmData.HasValue || !confirmData.Value) return;
        var command = new DeleteListCommand(_selectedList.Id, _userId);
        var message = await DeleteListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await LoadListsAsync(selectDefault: true);
    }
    private async Task CreateListAsync()
    {
        var parameters = new Dictionary<string, object?>(1) { [nameof(ListCreationDialog.UserId)] = _userId };
        var result = await DialogService.OpenAsync<ListCreationDialog>("Create List", parameters);
        if (result is not CreateListCommand command) return;

        var message = await CreateListHandler.HandleAsync(command);
        NotificationService.Show(message);

        await LoadListsAsync(selectDefault: true);
    }
    private async Task CreateTaskAsync()
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(TaskCreationDialog.ListId)] = _selectedList.Id, 
            [nameof(TaskCreationDialog.ListVersionId)] = _selectedList.VersionId
        };
        var result = await DialogService.OpenAsync<TaskCreationDialog>("Create Task", parameters);
        if (result is not CreateTaskCommand command) return;

        var message = await CreateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await LoadListsAsync(preferredSelectedId: _selectedList.Id);
    }

    private async Task OnToggleTask(TaskEntry entry)
    {
        var command = new ToggleTaskCommand(entry.Id, _selectedList.Id, _selectedList.VersionId);
        var message = await ToggleTaskHandler.HandleAsync(command);
        NotificationService.Show(message, duration: RadzenNotificationConstants.ShortDuration);

        await LoadListsAsync(preferredSelectedId: _selectedList.Id);
    }

    private async Task OnSettingsClicked(TaskEntry entry)
    {
        var parameters = new Dictionary<string, object?>(3)
        {
            [nameof(TaskUpdateDialog.OldEntry)] = entry,
            [nameof(TaskUpdateDialog.ListId)] = _selectedList.Id,
            [nameof(TaskUpdateDialog.ListVersionId)] = _selectedList.VersionId
        };
        var result = await DialogService.OpenAsync<TaskUpdateDialog>("Update Task", parameters);
        if (result is not UpdateTaskCommand command) return;

        var message = await UpdateTaskHandler.HandleAsync(command);
        NotificationService.Show(message);

        await LoadListsAsync(preferredSelectedId: _selectedList.Id);
    }
}
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@inherits LayoutComponentBase
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavManager
@inject UserSessionManager SessionManager
@inject CircuitState CircuitState
@implements IDisposable
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel>Todo Application</RadzenLabel>
            <div style="flex-grow: 1;"></div>
            <AuthorizeView>
                <Authorized>
                        <RadzenButton 
                            class="rz-display-flex rz-align-items-center rz-justify-content-center rz-background-color-primary rz-color-white" 
                            style="width: 40px; height: 40px; border-radius: 50%; font-weight: bold; font-size: 20px;"
                            Click="@(() => NavManager.NavigateTo(ApplicationRoutes.ManageAccount))"
                            Variant="Variant.Text">@(char.ToUpper(context.User.Identity?.Name?.First() ?? 'U'))</RadzenButton>
                </Authorized>
            </AuthorizeView>
            <div style="width: 20px;"></div>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="@MaterialIcons.Home" Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Home))" />
            <RadzenPanelMenuItem Text="Settings" Icon="@MaterialIcons.Settings" Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Settings))"/>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenComponents @rendermode="InteractiveServer" />
    <RadzenFooter>
        Washu Software
    </RadzenFooter>
</RadzenLayout>
<script>
    // Notice the ', true' at the end for capture phase
    document.addEventListener('submit', async function (e) {
        const form = e.target;
        const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
        
        if (!tokenInput || form.dataset.refreshed) return;

        // 1. Prevent native submit
        e.preventDefault();
        
        // 2. Freeze Blazor's scripts from intercepting this submit event
        e.stopImmediatePropagation();

        try {
            const response = await fetch('/antiforgery/token');
            if (response.ok) {
                tokenInput.value = await response.text();
            }
        } catch (err) {
            console.warn('Could not refresh token, submitting existing one', err);
        } finally {
            form.dataset.refreshed = "true";
            form.submit(); // Clean submit with the fresh token
        }
    }, true); // <--- 'true' puts this in the capture phase (runs first)
</script>
@code {
    bool sidebarExpanded = true;
    HttpContext Context => HttpContextAccessor.HttpContext ?? throw new InvalidOperationException("An active HttpContext is required.");
    Guid UserId;
    protected override void OnInitialized()
    {
        if (Context.User.FindUserId() is not {} userGuid) return;
        UserId = userGuid;
        SessionManager.AddSession(userGuid, CircuitState.Id, () =>
        {
            NavManager.Refresh(forceReload: true);
            return Task.CompletedTask;
        });
    }

    public void Dispose()
    {
        SessionManager.RemoveSession(UserId, CircuitState.Id);
    }

}
@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Identity
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject UserSessionManager SessionManager
@inject ApplicationSessionState SessionState
@inject ApplicationUserStore<TodoDbContext> UserStore
@implements IDisposable
<QueryNotificationHandler />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel>Todo Application</RadzenLabel>
            <div style="flex-grow: 1;"></div>
            <ThemeToggle/>
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
                                <RadzenText
                                    class="rz-display-flex rz-align-items-center rz-justify-content-center"
                                    style="flex-shrink: 0; width: 40px; left: 10px; height: 40px; border-radius: 50%; font-weight: bold; font-size: 20px; background-color: var(--rz-secondary); color: var(--rz-white);"
                                >@Username.First()</RadzenText>
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Manage Account" Icon="@MaterialIcons.AccountCircle" Path="@ApplicationRoutes.ManageAccount"></RadzenProfileMenuItem>
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
            </AuthorizeView>
            <div style="width: 10px;"></div>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="@MaterialIcons.Home" Path="@ApplicationRoutes.Home"/>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenComponents @rendermode="InteractiveServer" />
    <RadzenFooter>
        Washu Software
    </RadzenFooter>
</RadzenLayout>
@code {
    bool sidebarExpanded = true;
    string Username = "User";
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }
    Guid? UserId;
    protected override async Task OnInitializedAsync()
    {
        var state = await Context;
        if (state.User.FindUserId() is not {} userGuid) return;
        UserId = userGuid;
        Username = (await UserStore.GetOrAddUserAsync(userGuid))?.Username ?? "User";
        SessionManager.AddSession(userGuid, SessionState.Id, () =>
        {
            NavManager.Refresh(forceReload: true);
            return Task.CompletedTask;
        });
        UserStore.OnUserChanged += RefreshAsync;
    }

    public async Task RefreshAsync()
    {
        if (UserId.HasValue)
            Username = (await UserStore.GetOrAddUserAsync(UserId.Value))?.Username ?? "User";
        await InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        if (UserId.HasValue)
            SessionManager.RemoveSession(UserId.Value, SessionState.Id);
        UserStore.OnUserChanged -= RefreshAsync;
    }

}
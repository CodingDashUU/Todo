@using Washu.Framework.Extensions
@using Washu.Framework.Identity
@using Washu.Todo.Identity
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject UserSessionManager SessionManager
@inject CircuitState CircuitState
@inject CurrentUserService<TodoDbContext> CurrentUserService
@implements IDisposable
<QueryNotificationHandler />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel>Todo Application</RadzenLabel>
            <div style="flex-grow: 1;"></div>
            <AuthorizeView>
                <Authorized>
                        <RadzenButton 
                            class="rz-display-flex rz-align-items-center rz-justify-content-center" 
                            style="width: 40px; height: 40px; border-radius: 50%; font-weight: bold; font-size: 20px; background-color: var(--rz-secondary); color: var(--rz-white);"
                            Click="@(() => NavManager.NavigateTo(ApplicationRoutes.ManageAccount))"
                            Variant="Variant.Text">@FirstUsernameLetter</RadzenButton>
                </Authorized>
            </AuthorizeView>
            <div style="width: 20px;"></div>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="@MaterialIcons.Home" Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Home))" />
            <RadzenPanelMenuItem Text="Settings" Icon="@MaterialIcons.Settings" Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Settings))"/>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenComponents @rendermode="InteractiveServer" />
    <RadzenFooter>
        Washu Software
    </RadzenFooter>
</RadzenLayout>
@code {
    bool sidebarExpanded = true;
    char FirstUsernameLetter = 'U';
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }
    Guid? UserId;
    protected override async Task OnInitializedAsync()
    {
        var state = await Context;
        if (state.User.FindUserId() is not {} userGuid) return;
        UserId = userGuid;
        FirstUsernameLetter = (await CurrentUserService.GetCurrentUserAsync())?.Username.First() ?? 'U';
        SessionManager.AddSession(userGuid, CircuitState.Id, () =>
        {
            NavManager.Refresh(forceReload: true);
            return Task.CompletedTask;
        });
        CurrentUserService.OnUserChanged += RefreshAsync;
    }

    public async Task RefreshAsync()
    {
        FirstUsernameLetter = (await CurrentUserService.GetCurrentUserAsync())?.Username.First() ?? 'U';
        StateHasChanged();
    }
    public void Dispose()
    {
        if (UserId.HasValue)
            SessionManager.RemoveSession(UserId.Value, CircuitState.Id);
        CurrentUserService.OnUserChanged -= RefreshAsync;
    }

}
@using FluentValidation
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Entities
@inject ApplicationUserManager UserManager
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject ApplicationUserStore UserStore
@inject UserSessionManager SessionManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationSessionState SessionState
@inject MessageStore Store
@inject DialogService DialogService

@if (User is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    return;
}
<RadzenCard Variant="Variant.Outlined">
    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
        <RadzenText class="wrapped-text">Current Username: <b>@User.Username</b></RadzenText>
        <RadzenText class="wrapped-text">Email: <b>@User.Email</b></RadzenText>
        <RadzenButton class="wrapped-text" Click="OnChangeUsernameAsync" Text="Change Username" Icon="@MaterialIcons.Update"/> 
        <div style="height: 20px;"></div>

        <RadzenButton class="wrapped-text" Click="@SignOutAsync" Text="Sign Out" Icon="@MaterialIcons.Logout"/>
        <RadzenButton class="wrapped-text" Click="@DeleteAccountAsync" Text="Delete Account" Icon="@MaterialIcons.Delete" ButtonStyle="ButtonStyle.Danger"/>
    </RadzenStack>
</RadzenCard>
@code {
    private ApplicationUser User { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        await RefreshUserAsync();
    }

    private async Task OnChangeUsernameAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["OldUsername"] = User.Username
        };
        var data = await DialogService.OpenAsync<ChangeUsernameDialog>("Change Username", parameters);
        if (data is not ChangeUsernameDialog.ChangeUsernameModel model) return;
        var message = await UserManager.ChangeUsernameAsync(User.Username, model.Username, User.Id);
        NotificationService.Show(message);
        UserStore.RemoveUser(User.Id);
        await RefreshUserAsync();
        await SessionManager.OnRefreshSessionAsync(User.Id, SessionState.Id);
        StateHasChanged();
        await UserStore.UserHasChangedAsync();
    }

    private async Task RefreshUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.FindUserId() is not { } userId)
        {
            NavManager.NavigateTo(ApplicationRoutes.SignIn);
            return;
        }
        var user = await UserStore.GetOrAddUserAsync(userId);
        if (user is null)
        {
            NavManager.NavigateTo(ApplicationRoutes.SignIn);
            return;
        }
        User = user;
    }
    private async Task SignOutAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.FindUserId() is { } userId)
        {
            await SessionManager.OnRefreshSessionAsync(userId, SessionState.Id);
        }
        NavManager.NavigateTo(IdentityRoutes.SignOut, forceLoad: true);
    }
    private async Task DeleteAccountAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Email"] = User.Email
        };
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete your account? You cannot undo this action!", 
            "Confirm Account Deletion", 
            options: new ConfirmOptions
        {
            Icon = MaterialIcons.Delete,
            IconColor = "var(--rz-danger)",
            OkButtonText = "Yes",
            CancelButtonText = "No" 
        });
        if (!confirmData.HasValue || !confirmData.Value) return;
        var data = await DialogService.OpenAsync<ConfirmAccountDeletionDialog>("Confirm Account Deletion", parameters);
        if (data is not ConfirmAccountDeletionDialog.ConfirmAccountDeletionModel) return;
        var message = await UserManager.DeleteByIdAsync(User.Id);

        if (message.Type is not MessageType.Success)
        {
            NotificationService.Show(message);
            return;
        }

        await SessionManager.OnRefreshSessionAsync(User.Id, SessionState.Id);
        var id = Store.Store(message);
        NavManager.NavigateTo($"{IdentityRoutes.SignOut}?messageId={id}", forceLoad: true);
    }
}
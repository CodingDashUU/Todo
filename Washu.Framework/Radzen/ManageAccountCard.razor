@using Microsoft.AspNetCore.Http
@inject MessageStore MessageStore
@inject NavigationManager NavManager
@inject IHttpContextAccessor HttpContextAccessor
<RadzenCard Variant="Variant.Outlined">
    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
        <RadzenText>Current Username: @_name</RadzenText>
        <RadzenText>Email: @_email</RadzenText>
        <ChangeUsernameForm Principal="HttpContext.User"/>
        <div height="20px"></div>
        <SignOutForm/>
        <DeleteAccountForm/>
    </RadzenStack>
</RadzenCard>

@code {
    private string _email = "Unknown";
    private string _name = "Unknown";

    private HttpContext HttpContext => HttpContextAccessor.HttpContext
                                       ?? throw new InvalidOperationException("An active HttpContext is required");

    protected override void OnInitialized()
    {
        if (HttpContext.User.Identity is not { Name: not null } userContext)
        {
            RedirectToLogin("Invalid session");
            return;
        }
        _name = userContext.Name;
        if (HttpContext.User.FindFirstValue(ClaimTypes.Email) is not { } email)
        {
            RedirectToLogin("No email was found");
            return;
        }
        _email = email;
    }
    private void RedirectToLogin(string errorMessage)
    {
        var id = MessageStore.Store(Message.Error("Identity Error", errorMessage));
        NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?messageId={id}");
    }
}
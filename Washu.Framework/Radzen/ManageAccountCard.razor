@using FluentValidation
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Entities
@inject ApplicationUserManager<TDbContext> UserManager
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject CurrentUserService<TDbContext> CurrentUserService
@inject UserSessionManager SessionManager
@inject AuthenticationStateProvider AuthStateProvider
@inject CircuitState CircuitState
@inject MessageStore Store
@inject DialogService DialogService
@typeparam TDbContext where TDbContext : ApplicationDbContext

@if (User is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    return;
}
<RadzenCard Variant="Variant.Outlined">
    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
        <RadzenText>Current Username: <b>@User.Username</b></RadzenText>
        <RadzenText>Email: <b>@User.Email</b></RadzenText>
        <AppForm
            Model="Model"
            Validator="Validator"
            SubmitButtonConfig="ChangeUsernameButtonConfig"
            HandleValidSubmit="OnChangeUsernameAsync"
            >
            <RadzenFormField Text="New Username">
                <Start>
                    <RadzenIcon Icon="@MaterialIcons.AccountCircle"/>
                </Start>
                <ChildContent>
                    <RadzenTextBox @bind-Value="@Model.Username" MaxLength="Username.Rules.MaxUsernameLength"/>
                </ChildContent>
            </RadzenFormField>
        </AppForm>
        <div style="height: 20px;"></div>

        <RadzenButton Click="@SignOutAsync" Text="Sign Out" Icon="@MaterialIcons.Logout"/>
        <RadzenButton  Click="@DeleteAccountAsync" Text="Delete Account" Icon="@MaterialIcons.Delete" ButtonStyle="ButtonStyle.Danger"/>
    </RadzenStack>
</RadzenCard>
@code {
    private ApplicationUser User { get; set; } = null!;
    private ChangeUsernameModel Model { get; set; } = new();
    private ChangeUsernameValidator Validator { get; set; } = new();
    private bool UsernameChanged => Model.Username != User.Username;

    private SubmitButtonConfig ChangeUsernameButtonConfig => new()
    {
        ButtonDisabled = !UsernameChanged,
        ButtonText = "Update Username",
        ButtonIcon = MaterialIcons.Update
    };
    protected override async Task OnInitializedAsync()
    {
        var success = await RefreshUserAsync();
        if (!success) return;
        Model.Username = User.Username;
    }

    private async Task OnChangeUsernameAsync()
    {
        var message = await UserManager.ChangeUsernameAsync(User.Username, Model.Username, User.Id);
        NotificationService.Show(message);
        CurrentUserService.ClearCache();
        await RefreshUserAsync();
        StateHasChanged();
        await CurrentUserService.UserHasChangedAsync();
    }

    private async Task<bool> RefreshUserAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null)
        {
            NavManager.NavigateTo(ApplicationRoutes.SignIn);
            return false;
        }
        User = user;
        return true;
    }
    private async Task SignOutAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.FindUserId() is { } userId)
        {
            await SessionManager.InvalidateAsync(userId, CircuitState.Id);
        }
        NavManager.NavigateTo(IdentityRoutes.SignOut, forceLoad: true);
    }
    private async Task DeleteAccountAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Email"] = User.Email
        };
        var data = await DialogService.OpenAsync<ConfirmAccountDeletionDialog>("Are you sure you want to delete your account?", parameters);
        if (data is not ConfirmAccountDeletionDialog.ConfirmAccountDeletionModel) return;
        var message = await UserManager.DeleteByIdAsync(User.Id);

        if (message.Type is not MessageType.Success)
        {
            NotificationService.Show(message);
            return;
        }

        await SessionManager.InvalidateAsync(User.Id, CircuitState.Id);
        var id = Store.Store(message);
        NavManager.NavigateTo($"{IdentityRoutes.SignOut}?messageId={id}", forceLoad: true);
    }

    class ChangeUsernameModel
    {
        public string Username { get; set; } = string.Empty;
    }

    class ChangeUsernameValidator : AbstractValidator<ChangeUsernameModel>
    {
        public ChangeUsernameValidator()
        {
            RuleFor(x => x.Username)
                .SetValidator(new Username.Validator());
        }
    }
}
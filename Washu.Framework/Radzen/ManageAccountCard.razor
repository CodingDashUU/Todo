@inject MessageStore MessageStore
@inject NavigationManager NavManager
<RadzenCard Variant="Variant.Outlined">
    <RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
        <RadzenText>Current Username: @_name</RadzenText>
        <RadzenText>Email: @_email</RadzenText>
        @if (_principal is not null)
        {
            <ChangeUsernameForm Principal="_principal"/>
        }
        <div style="height: 20px;"></div>
        <SignOutForm/>
        <DeleteAccountForm/>
    </RadzenStack>
</RadzenCard>

@code {
    private string _email = "Unknown";
    private string _name = "Unknown";
    private ClaimsPrincipal? _principal;

    [CascadingParameter] public required Task<AuthenticationState> AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _principal = authState.User;

        if (_principal.Identity is not { Name: not null } userContext)
        {
            RedirectToLogin("Invalid session");
            return;
        }
        _name = userContext.Name;
        if (_principal.FindFirstValue(ClaimTypes.Email) is not { } email)
        {
            RedirectToLogin("No email was found");
            return;
        }
        _email = email;
    }
    private void RedirectToLogin(string errorMessage)
    {
        var id = MessageStore.Store(Message.Error("Identity Error", errorMessage));
        NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?messageId={id}");
    }
}
@using Humanizer
@using Washu.Framework.Extensions
@inject ChangeUsernameHandler ChangeUsernameHandler
@inject DeleteUserHandler DeleteUserHandler
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject ApplicationUserStore UserStore
@inject MessageStore Store
@inject DialogService DialogService
@inject UserTimeZoneProvider TimeZoneProvider

<RadzenCard Variant="Variant.Outlined" class="rz-p-4 rz-p-md-6" Style=" margin: 0 auto;">
        <RadzenStack Gap="1rem">
            
            <!-- Header & Profile Overview -->
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenGravatar Email="@User.Email" 
                                Size="64" 
                                class="rz-border-radius-circle" 
                                Style="border: 2px solid var(--rz-primary-light);" />

                <RadzenStack Gap="0.25rem" class="rz-flex-grow-1">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mb-0 wrapped-text">
                        @User.Username
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                        @User.Email
                    </RadzenText>
                </RadzenStack>
                
            </RadzenStack>
            <RadzenButton Icon="@MaterialIcons.Logout" 
                          Text="Sign Out" 
                          ButtonStyle="ButtonStyle.Base" 
                          Variant="Variant.Outlined" 
                          Size="ButtonSize.Small" 
                          Click="@SignOut" />
            <RadzenButton Icon="@MaterialIcons.Logout" 
                          Text="Sign Out From All Sessions" 
                          ButtonStyle="ButtonStyle.Base" 
                          Variant="Variant.Outlined" 
                          Size="ButtonSize.Small" 
                          Click="@SignOutFromAllSessions" />

            <!-- Divider using Radzen CSS utility -->
            <hr class="rz-my-0 rz-border-top rz-border-base-300" />

            <!-- Profile Details & Actions -->
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-primary">
                    Account Information
                </RadzenText>

                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
                            Username
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                            @User.Username
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
                <div style="height: 3px"/>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
                            Email Address
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                            @User.Email
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
                <hr class="rz-my-0 rz-border-top rz-border-base-300" />
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
                            Account Created
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                            @CreationDate.ToString("F") (@CreationDate.Humanize())
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
                <div style="height: 3px"/>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
                            Last Modified
                        </RadzenText>
                        @if (LastModifiedDate.HasValue)
                        {
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                                @(LastModifiedDate.Value.ToString("F")) (@LastModifiedDate.Value.Humanize())
                            </RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                                Never
                            </RadzenText>
                        }
                    </RadzenColumn>
                </RadzenRow>
                <div style="height: 3px"/>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary rz-mb-0">
                            Last Signed In
                        </RadzenText>
                        @if (LastSignedInDate.HasValue)
                        {
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                                @(LastSignedInDate.Value.ToString("F")) (@LastSignedInDate.Value.Humanize())
                            </RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0 rz-font-weight-bold">
                                Never
                            </RadzenText>
                        }
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
            <!-- Divider using Radzen CSS utility -->
            <hr class="rz-my-0 rz-border-top rz-border-base-300" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-primary">
                Account Action
            </RadzenText>
            <RadzenButton Icon="@MaterialIcons.Update" 
                          Text="Change Username" 
                          ButtonStyle="ButtonStyle.Primary" 
                          Variant="Variant.Flat" 
                          Size="ButtonSize.Small" 
                          Click="@OnChangeUsernameAsync" />
            <!-- Danger Zone -->
            <RadzenCard Variant="Variant.Filled" 
                        class=" rz-background-color-danger-lighter rz-border-radius-2" 
                        Style="border: 1px solid var(--rz-danger-light);">
                    <RadzenStack>
                        <RadzenText TextStyle="TextStyle.H6" class="rz-color-danger-dark">
                            Danger Zone
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-danger">
                            Permanently delete your account and all associated data.
                        </RadzenText>
                        <RadzenButton Icon="@MaterialIcons.Delete" 
                                      Text="Delete Account" 
                                      ButtonStyle="ButtonStyle.Danger" 
                                      Variant="Variant.Filled" 
                                      Size="ButtonSize.Small" 
                                      Click="@DeleteAccountAsync" />
                    </RadzenStack>
            </RadzenCard>

        </RadzenStack>
    </RadzenCard>

@code {
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }
    private ApplicationUserInfo User { get; set; } = new();
    private DateTimeOffset CreationDate => User.CreationDate.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    private DateTimeOffset? LastModifiedDate => User.LastModifiedDate?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    private DateTimeOffset? LastSignedInDate => User.LastSignedInDate?.ToTimeZone(TimeZoneProvider.TimeZoneInfo);
    private static readonly ConfirmOptions ConfirmAccountDeletionOptions = new()
    {
        Icon = MaterialIcons.Delete,
        IconColor = "var(--rz-danger)",
        OkButtonText = "Yes",
        CancelButtonText = "No" 
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshUserAsync();
    }

    private async Task OnChangeUsernameAsync()
    {
        var parameters = new Dictionary<string, object?>(3)
        {
            [nameof(ChangeUsernameDialog.OldUsername)] = User.Username,
            [nameof(ChangeUsernameDialog.UserId)] = User.Id,
            [nameof(ChangeUsernameDialog.UserVersionId)] = User.VersionId
        };
        var data = await DialogService.OpenAsync<ChangeUsernameDialog>("Change Username", parameters);
        if (data is not ChangeUsernameCommand command) return;
        var result = await ChangeUsernameHandler.HandleAsync(command);
        switch (result)
        {
            case ChangeUsernameResult.AccountNotFound:
            {
                var id = Store.Store(Message.Error("Identity Error", "Account not found"));
                await UserStore.RemoveUserAsync(User.Id);
                NavManager.NavigateTo($"{IdentityRoutes.SignOut}?messageId={id}", forceLoad: true);
                return;
            }
            case ChangeUsernameResult.UserAlreadyModified:
                NotificationService.Show(Message.Error("Identity Error", "Account already modified"));
                await RefreshUserAsync();
                return;
        }

        var message = result switch
        {
            ChangeUsernameResult.UsernameTaken => Message.Error("Identity Error", "Username taken"),
            ChangeUsernameResult.Success => Message.Success("Identity Success", "Successfully changed username"),
            _ => throw new ArgumentOutOfRangeException()
        };
        NotificationService.Show(message);
        if (message.Type is MessageType.Success)
        {
            await UserStore.RemoveUserAsync(User.Id);
            await RefreshUserAsync();
        }
        StateHasChanged();
    }

    private async Task RefreshUserAsync()
    {
        var state = await Context;
        if (state.User.UserId is not { } userId
            || state.User.SecurityStamp is not { } securityStamp
            || await UserStore.GetOrSetUserAsync(userId) is not { } user
            || user.SecurityStamp != securityStamp)
        {
            Redirect();
            return;
        }
        User = new ApplicationUserInfo
        {
            Id = user.Id,
            Username = user.Username,
            Email = user.Email,
            CreationDate = user.CreationDate,
            LastModifiedDate = user.LastModifiedDate,
            LastSignedInDate = user.LastSignedInDate,
            VersionId = user.VersionId
        };
    }
    private void Redirect() => NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?returnUrl={ApplicationRoutes.Home}", forceLoad: true);
    private void SignOut() => NavManager.NavigateTo(IdentityRoutes.SignOut, forceLoad: true);

    private void SignOutFromAllSessions()
    {
        NavManager.NavigateTo(IdentityRoutes.SignOutFromAllSessions, forceLoad: true);
    }
    private async Task DeleteAccountAsync()
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(ConfirmAccountDeletionDialog.Email)] = User.Email,
            [nameof(ConfirmAccountDeletionDialog.UserId)] = User.Id
        };
        var confirmData = await DialogService.Confirm(
            "Are you sure you want to delete your account? You cannot undo this action!", 
            "Confirm Account Deletion", 
            options: ConfirmAccountDeletionOptions);
        if (!confirmData.HasValue || !confirmData.Value) return;
        var data = await DialogService.OpenAsync<ConfirmAccountDeletionDialog>("Confirm Account Deletion", parameters);
        if (data is not DeleteUserCommand command) return;
        var result = await DeleteUserHandler.HandleAsync(command);
        var message = result switch
        {
            DeleteUserResult.AccountNotFound => Message.Error("Identity Error", "Account not found"),
            DeleteUserResult.Success => Message.Success("Identity Success", "Successfully deleted account"),
            _ => throw new ArgumentOutOfRangeException()
        };
        await UserStore.RemoveUserAsync(User.Id);
        var id = Store.Store(message);
        NavManager.NavigateTo($"{IdentityRoutes.SignOut}?messageId={id}", forceLoad: true);
    }

    private sealed class ApplicationUserInfo
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = "UNKNOWN";
        public string Email { get; set; } = "UNKNOWN";
        public DateTimeOffset CreationDate { get; set; } = DateTimeOffset.UtcNow;
        public DateTimeOffset? LastModifiedDate { get; set; } = DateTimeOffset.UtcNow;
        public DateTimeOffset? LastSignedInDate { get; set; } = DateTimeOffset.UtcNow;
        public Guid VersionId { get; set; } = Guid.CreateVersion7();
    }

}
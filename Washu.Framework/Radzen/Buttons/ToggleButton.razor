<RadzenButton 
              ButtonStyle="@(IsOn ? ButtonStyle.Success : ButtonStyle.Danger)"
              Variant="Variant.Text"
              Click="@Toggle"
              Disabled="IsDisabled"
              Text="@(IsOn ? ButtonOnText : ButtonOffText)"/>

@code {
    [Parameter] public bool IsOn { get; set; }
    [Parameter, EditorRequired] public EventCallback<MouseEventArgs> Toggle { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string ButtonOffText { get; set; } = string.Empty;
    [Parameter] public string ButtonOnText { get; set; } = string.Empty;
}
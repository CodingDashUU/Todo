@inject DialogService DialogService
@typeparam TEntity where TEntity : class
<RadzenButton Click="OnDialogOpen" Text="Export Data" Icon="@MaterialIcons.FileExport" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Success"/>

@code {
    [Parameter, EditorRequired] public RadzenDataGrid<TEntity> DataGrid { get; set; }
    [Parameter, EditorRequired] public string ExcelTitle { get; set; }
    [Parameter, EditorRequired] public string FileName { get; set; }
    [Parameter, EditorRequired] public bool DisableExportAllScope { get; set; }

    private async Task OnDialogOpen()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(DataGridExportDialog<>.FileName)] = FileName,
            [nameof(DataGridExportDialog<>.ExcelTitle)] = ExcelTitle,
            [nameof(DataGridExportDialog<>.DataGrid)] = DataGrid,
            [nameof(DataGridExportDialog<>.DisableExportAllScope)] = DisableExportAllScope
        };
        var data = await DialogService.OpenAsync<DataGridExportDialog<TEntity>>("Table Export", parameters);
        if (data is not DataGridExportCommand<TEntity> command) return;
        await HandleExportAsync(command);
    }
    private async Task HandleExportAsync(DataGridExportCommand<TEntity> command)
    {
        switch (command.ExportMode)
        {
            case DataGridExportMode.Excel:
                await command.DataGrid.ExportToExcelAsync($"{command.FileName}.xlsx", 
                    new DataGridExcelExportOptions
                    {
                        Scope = DisableExportAllScope ? DataGridExportScope.CurrentPage : command.Scope, Title = command.ExcelTitle, UseTheme = command.UseTheme
                    });
                break;
            case DataGridExportMode.Csv:
                await command.DataGrid.ExportToCsvAsync($"{command.FileName}.csv", 
                    new DataGridCsvExportOptions { Scope = DisableExportAllScope ? DataGridExportScope.CurrentPage : command.Scope });
                break;
        }
    }
}
@inject ThemeService ThemeService
<form action="/theme" method="post">
    <AntiforgeryToken/>
    <RadzenStack>
        <RadzenFormField Text="Theme">
            <RadzenDropDown TValue="string" Name="theme" Value="@(ThemeService.Theme ?? Themes.Free.First().Value)" Data="@Themes.Free" TextProperty=@nameof(Theme.Text) ValueProperty=@nameof(Theme.Value) />
        </RadzenFormField>
        <RadzenButton ButtonType="ButtonType.Submit">Change Theme</RadzenButton>
    </RadzenStack>
</form>
@using Washu.Framework.AspNetCore
<form action="@CoreEndpointRoutes.Identity.DeleteAccount" method="post">
    <AntiforgeryToken/>
    <RadzenStack>
        <input type="hidden" name="username" value="@(Context.User.Identity?.Name ?? "none")" />
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Danger">Delete Account</RadzenButton>
    </RadzenStack>
</form>

@code {
    [Parameter] public required AuthenticationState Context { get; set; }
}
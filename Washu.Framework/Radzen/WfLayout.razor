@using Washu.Framework.Extensions
@inject ApplicationUserStore UserStore

<QueryNotificationHandler />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
            <RadzenLabel>@ApplicationName</RadzenLabel>
            <div style="flex-grow: 1;"></div>
            <ThemeToggle/>
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu>
                        <Template>
                            <RadzenGravatar Email="@_email" 
                                            Size="64" 
                                            class="rz-border-radius-circle" 
                                            Style="border: 2px solid var(--rz-primary-light);" />
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="Manage Account" Icon="@MaterialIcons.AccountCircle" Path="@ApplicationRoutes.ManageAccount"></RadzenProfileMenuItem>
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
            </AuthorizeView>
            <div style="width: 10px;"></div>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@_sidebarExpanded">
        <RadzenPanelMenu>
            @foreach (var item in PanelMenuItems)
            {
                <RadzenPanelMenuItem Text="@item.Name" Icon="@item.Icon" Path="@item.Path"/>
            }
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <ErrorBoundary @ref="_errorBoundary">
            <ErrorContent>
                <RadzenCard class="rz-my-12 rz-mx-auto rz-p-8" style="max-width: 450px;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem" class="rz-text-align-center">
                        <RadzenIcon Icon="sentiment_very_dissatisfied" Style="font-size: 3rem; color: var(--rz-danger);" />
        
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.DisplayH4">Page Error</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1">
                                An error has occurred while loading this view.
                            </RadzenText>
                        </RadzenStack>

                        <RadzenButton Text="Retry View" 
                                      Icon="refresh" 
                                      ButtonStyle="ButtonStyle.Danger" 
                                      Click="@(() => _errorBoundary?.Recover())" />
                    </RadzenStack>
                </RadzenCard>
            </ErrorContent>
            <ChildContent>
                <div class="rz-p-4">
                    @Content
                </div>
            </ChildContent>
        </ErrorBoundary>
    </RadzenBody>
    <RadzenComponents @rendermode="InteractiveServer" />
    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenStack JustifyContent="JustifyContent.Center">
                <SymbolLogo Size="50"/>
            </RadzenStack>
            <RadzenStack JustifyContent="JustifyContent.Center">
                <RadzenText TextStyle="TextStyle.DisplayH6">Washu Software</RadzenText>
            </RadzenStack>
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>
@code {
    [Parameter, EditorRequired] public string ApplicationName { get; set; }
    [Parameter, EditorRequired] public PanelMenuItem[] PanelMenuItems { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    private bool _sidebarExpanded = true;
    private ErrorBoundary? _errorBoundary;
    private string _email = "";
    [CascadingParameter] public required Task<AuthenticationState> Context { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var state = await Context;
        if (state.User.UserId is not {} userGuid) return;
        _email = (await UserStore.GetOrSetUserAsync(userGuid))?.Email ?? "";
    }
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}
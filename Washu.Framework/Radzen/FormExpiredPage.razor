@attribute [Route(ApplicationRoutes.FormExpired)]
@inject NavigationManager NavManager

<PageTitle>Form Expired</PageTitle>
<RadzenCard class="rz-my-12 rz-mx-auto rz-p-8" style="max-width: 450px;">
    <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem" class="rz-text-align-center">
        <RadzenIcon Icon="@MaterialIcons.ErrorOutline" Style="font-size: 3rem; color: var(--rz-danger);"/>
        
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.DisplayH4">Form expired</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                This form is no longer valid. Please refresh the page and try again.
            </RadzenText>
        </RadzenStack>

        <RadzenButton Text="Go back"
                      Icon="@MaterialIcons.ArrowBack" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@(() => NavManager.NavigateTo(ApplicationRoutes.Home))" />
    </RadzenStack>
</RadzenCard>
<form action="@IdentityRoutes.ChangeUsername" method="post">
    <AntiforgeryToken/>
    <RadzenStack>
        <RadzenFormField Text="New Username">
            <Start>
                <RadzenIcon Icon="@MaterialIcons.AccountCircle"/>
            </Start>
            <ChildContent>
                <RadzenTextBox Name="NewUsername" Value="@(Context.User.Identity?.Name ?? "")" MaxLength="Username.Rules.MaxUsernameLength"/>
            </ChildContent>
        </RadzenFormField>
        <RadzenButton ButtonType="ButtonType.Submit">Change Username</RadzenButton>
    </RadzenStack>
</form>

@code {

    [Parameter] public required AuthenticationState Context { get; set; }

}
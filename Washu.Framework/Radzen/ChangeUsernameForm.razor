<form action="@IdentityRoutes.ChangeUsername" method="post">
    <AntiforgeryToken/>
    <RadzenStack>
        <CircuitId/>
        <RadzenFormField Text="New Username">
            <Start>
                <RadzenIcon Icon="@MaterialIcons.AccountCircle"/>
            </Start>
            <ChildContent>
                <RadzenTextBox Name="NewUsername" Value="@(Principal.Identity?.Name ?? "")" MaxLength="Username.Rules.MaxUsernameLength"/>
            </ChildContent>
        </RadzenFormField>
        <RadzenButton ButtonType="ButtonType.Submit">Change Username</RadzenButton>
    </RadzenStack>
</form>

@code {

    [Parameter] public required ClaimsPrincipal Principal { get; set; }

}
@typeparam TModel
@typeparam TValidator where TValidator : FluentValidation.IValidator
<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <FluentValidationValidator Validator="@Validator" />
    
    <RadzenStack Gap="1rem">
        @ChildContent
        <RadzenButton ButtonStyle="SubmitButtonConfig.ButtonStyle" 
                      Text="@SubmitButtonConfig.ButtonText" 
                      Disabled="SubmitButtonConfig.ButtonDisabled" 
                      Icon="@SubmitButtonConfig.ButtonIcon"
                      ButtonType="ButtonType.Submit"
                      class="wrapped-text"/>
        <ValidationSummaryCard />
    </RadzenStack>
</EditForm>

@code {

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public required TModel Model { get; set; }
    [Parameter] public required TValidator Validator { get; set; }
    [Parameter] public Action HandleValidSubmit { get; set; } = () => {};
    [Parameter] public SubmitButtonConfig  SubmitButtonConfig { get; set; } = new();

}
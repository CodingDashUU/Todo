@if (_messages.Any())
{
    <RadzenCard Style="
    margin: 24px auto;
    width: calc(100% - 48px);
    background-color: color-mix(in srgb, var(--rz-danger) 12%, var(--rz-card-background-color, #1e1e1e));
    border: 1px solid var(--rz-danger);
    backdrop-filter: blur(16px);
    border-radius: 20px;
">
    <div style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    ">
        <div style="
            display: flex;
            align-items: center;
            gap: 18px;
        ">
            <RadzenIcon Icon="@MaterialIcons.ErrorOutline" 
                        Style="color: var(--rz-danger); font-size: 1.85rem; line-height: 1.2; flex-shrink: 0; height: 100%" />
            <RadzenStack Gap="0.35rem" Style="flex-grow: 1;">
                
                <RadzenText TextStyle="TextStyle.Body1" 
                            Style="color: var(--rz-danger); font-weight: 600; margin: 0; line-height: 1.2;">
                    @(_messages.Count == 1 ? "Please fix the following error:" : "Please fix the following errors:")
                </RadzenText>
                
                @if (_messages.Count == 1)
                {
                    <RadzenText Style="color: var(--rz-text-color, #ffffff); opacity: 0.9; margin: 0;">
                        @_messages[0]
                    </RadzenText>
                }
                else
                {
                    @foreach (var message in _messages)
                    {
                        <RadzenText Style="color: var(--rz-text-color, #ffffff); opacity: 0.9; margin: 0;">
                            → @message
                        </RadzenText>
                    }
                }

            </RadzenStack>
            <div>
            </div>
        </div>
    </div>
</RadzenCard>
}

@code {
    private List<string> _messages = [];

    public void SetMessages(params List<string> messages)
    {
        _messages = messages;
        StateHasChanged();
    }
}
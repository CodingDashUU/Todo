@typeparam TModel
<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <RadzenStack Gap="1rem">
        @ChildContent
        <RadzenButton ButtonStyle="SubmitButtonConfig.ButtonStyle" 
                      Text="@SubmitButtonConfig.ButtonText" 
                      Disabled="SubmitButtonConfig.ButtonDisabled" 
                      Icon="@SubmitButtonConfig.ButtonIcon"
                      ButtonType="ButtonType.Submit"
                      Variant="Variant.Outlined"/>
        <ValidationSummaryCard @ref="@_validationSummaryCard"/>
    </RadzenStack>
</EditForm>

@code {
    private ValidationSummaryCard _validationSummaryCard = null!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public TModel Model { get; set; }
    [Parameter, EditorRequired] public EventCallback<EditContext> HandleValidSubmit { get; set; }
    [Parameter] public SubmitButtonConfig  SubmitButtonConfig { get; set; } = new();
    public void SetErrorMessages(params List<string> messages)
    {
        if (messages.Any())
            _validationSummaryCard.SetMessages(messages);
        StateHasChanged();
    }

}
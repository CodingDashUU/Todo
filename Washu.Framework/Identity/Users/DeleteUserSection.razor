@using System.Diagnostics
@using global::Radzen
@using global::Radzen.Blazor
@using Mediator
@using Washu.Framework.AspNetCore
@using Washu.Framework.Extensions
@using Washu.Framework.Identity.Authentication
@using Washu.Framework.Notifications
@using Washu.Framework.SharedComponents
@using Washu.Framework.SharedComponents.Notifications
@inject DialogService DialogService
@inject MessageStore Store
@inject NavigationManager NavManager
@inject NotificationService NotificationService

<RadzenCard Variant="Variant.Filled"
            class=" rz-background-color-danger-lighter rz-border-radius-2" 
            Style="border: 1px solid var(--rz-danger-light);">
    <RadzenStack>
        <RadzenText TextStyle="TextStyle.H6" class="rz-color-danger-dark">
            Danger Zone
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-danger">
            Permanently delete your account and all associated data.
        </RadzenText>
        <RadzenButton Icon="@MaterialIcons.Delete" 
                      Text="Delete Account" 
                      ButtonStyle="ButtonStyle.Danger" 
                      Variant="Variant.Filled" 
                      Size="ButtonSize.Small" 
                      Click="@DeleteAccountAsync" />
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public ApplicationUserInfo User { get; set; }
    [Parameter, EditorRequired] public Func<Task> OnRefreshUserAsync { get; set; }

    private async Task DeleteAccountAsync()
    {
        var parameters = new Dictionary<string, object?>(2)
        {
            [nameof(ConfirmAccountDeletionDialog.UserId)] = User.Id,
            [nameof(ConfirmAccountDeletionDialog.UserRowVersion)] = User.RowVersion
        };
        var confirmData = await DialogService.ConfirmDelete(
            "Confirm Account Deletion",
            "Are you sure you want to delete your account? You cannot undo this action!");
        if (!confirmData) return;
        var data = await DialogService.OpenAsync<ConfirmAccountDeletionDialog>("Confirm Account Deletion", parameters);
        if (data is not Result result) return;
        var message = result switch
        {
            Error e => Message.Error("Identity Error", e.Message),
            UnitValue => Message.Success("Identity Success", "Account deleted successfully"),
            null => throw new UnreachableException()
        };
        if (result is not ConcurrencyError)
        {
            var id = Store.Store(message);  
            NavManager.NavigateTo($"{IdentityRoutes.SignOut}?messageId={id}", forceLoad: true);
            return;
        }
        NotificationService.Show(message);
        await OnRefreshUserAsync();
    }
}
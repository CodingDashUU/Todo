@using FluentValidation
@using Mediator
@using Radzen
@using Radzen.Blazor
@using Washu.Framework.SharedComponents
@inject DialogService DialogService
@inject IMediator Mediator
<ApplicationForm
    @ref="_form"
    Model="_model"
    SubmitButtonConfig="ChangeUsernameButtonConfig"
    HandleValidSubmit="CloseDialog"
>
    <RadzenFormField Text="New Username">
        <Start>
            <RadzenIcon Icon="@MaterialIcons.AccountCircle"/>
        </Start>
        <ChildContent>
            <RadzenTextBox @bind-Value="@_model.Username" MaxLength="UsernameRules.MaxUsernameLength"/>
        </ChildContent>
    </RadzenFormField>
</ApplicationForm>

@code {
    private ApplicationForm<Model> _form = null!;
    private readonly Model _model = new();
    [Parameter, EditorRequired] public string OldUsername { get; set; }
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public uint UserVersionId { get; set; }
    private static readonly SubmitButtonConfig ChangeUsernameButtonConfig = new()
    {
        ButtonText = "Update Username",
        ButtonIcon = MaterialIcons.Update
    };
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _model.Username = OldUsername;
    }

    private async Task CloseDialog()
    {
        var command = new ChangeUsernameCommand(UserId, UserVersionId, OldUsername, _model.Username);
        var result = await Mediator.Send(command);
        if (result is Error { Type: ValidationError vErr })
        {
            _form.SetErrorMessages(vErr.Errors);
            await InvokeAsync(StateHasChanged);
        }
        else DialogService.Close(result);
    }
    private class Model
    {
        public string Username { get; set; } = string.Empty;
    }
}
@using FluentValidation
@using Mediator
@using Radzen
@using Radzen.Blazor
@using Washu.Framework.SharedComponents
@inject DialogService DialogService
@inject ISender Sender
<ApplicationForm
    @ref="_form"
    Model="_model"
    HandleValidSubmit="CloseDialog"
    SubmitButtonConfig="DeleteAccountButtonConfig"
>
    <RadzenFormField Text="Type your email to confirm deletion">
        <Start>
            <RadzenIcon Icon="@MaterialIcons.Email"/>
        </Start>
        <ChildContent>
            <RadzenTextBox @bind-Value="@_model.Email" MaxLength="255"/>
        </ChildContent>
    </RadzenFormField>
</ApplicationForm>

@code {
    private ApplicationForm<Model> _form = null!;
    private readonly Model _model = new();
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter, EditorRequired] public uint UserRowVersion { get; set; }
    public SubmitButtonConfig DeleteAccountButtonConfig { get; init; } = new()
    {
        ButtonText = "Delete Account!",
        ButtonStyle = ButtonStyle.Danger,
        ButtonIcon = MaterialIcons.Delete
    };

    private async Task CloseDialog()
    {
        var command = new DeleteUserCommand(UserId, UserRowVersion, _model.Email);
        var result = await Sender.Send(command);
        if (result is ValidationError err)
        {
            _form.SetErrorMessages(err.Errors);
            await InvokeAsync(StateHasChanged);
        }
        else DialogService.Close(result);
    }
    private class Model
    {
        public string Email { get; set; } = "";
    }
    
}
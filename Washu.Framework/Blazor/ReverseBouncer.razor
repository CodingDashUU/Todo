@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
<AuthorizeView>
    <Authorized>
        @{
            NavManager.NavigateTo($"{ApplicationRoutes.Home}");
        }
    </Authorized>
    <NotAuthorized>
        @ChildContent
    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter] public required RenderFragment ChildContent { get; set; }
}
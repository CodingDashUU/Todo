@using Microsoft.AspNetCore.Components.Authorization
@using Washu.Framework.Constants
@inject NavigationManager NavManager
<AuthorizeView>
    <Authorized>
        @ChildContent?.Invoke(context)
    </Authorized>
    <NotAuthorized>
        @{
            NavManager.NavigateTo($"{ApplicationRoutes.SignIn}?ReturnUrl={ReturnUrl}");
        }
    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter] public RenderFragment<AuthenticationState>? ChildContent { get; set; }
    [Parameter] public required string ReturnUrl { get; set; }
}